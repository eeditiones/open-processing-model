<?xml-model href="teipublisher_odds.xsd"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:pb="http://teipublisher.com/1.0" xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Person-Note Customization <desc>Derived from teipublisher.odd, showing person
                        notes for persName references</desc>
                </title>
            </titleStmt>
            <publicationStmt>
                <publisher>eXistSolutions GmbH</publisher>
                <availability>
                    <licence target="https://www.gnu.org/licenses/gpl-3.0.en.html">Distributed under
                        GNU General Public License</licence>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Derived from <ref target="teipublisher.odd">teipublisher.odd</ref>.</p>
            </sourceDesc>
        </fileDesc>
        <revisionDesc>
            <change when="2026-04-20">Add persName rule resolving @ref/@key to person note without
                pb-popover.</change>
            <change when="2026-04-20">Override person in register mode: persName, then birth/death,
                then note.</change>
        </revisionDesc>
        <encodingDesc>
            <tagsDecl>
                <rendition source="test.css"/>
            </tagsDecl>
        </encodingDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" ident="test" source="teipublisher.odd">
                <elementSpec ident="persName" mode="change">
                    <model predicate="@type='variant'" behaviour="inline" cssClass="name variant"/>
                    <model predicate="parent::person" behaviour="inline"/>
                    <model predicate="ancestor::correspContext" behaviour="inline"/>
                    <model predicate="@key or @ref" behaviour="alternate" cssClass="persName context">
                        <desc>Resolve @ref/@key to the corresponding person in the same TEI and show
                            its note as alternate content.</desc>
                        <param name="default" value="."/>
                        <param name="alternate" value="id(replace(string((@ref, @key)[1]), '^#', ''), root(.))"/>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="person" mode="change">
                    <model predicate="parent::listPerson" behaviour="block">
                        <param name="name" value="persName"/>
                        <param name="dates" value="(birth, death)"/>
                        <param name="note" value="note"/>
                        <pb:template xmlns="">
                            <h4>[[name]] [[dates]]</h4>
                            [[note]]
                        </pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="TEI" mode="change">
                    <model behaviour="document"/>
                </elementSpec>
                <elementSpec ident="birth" mode="change">
                    <model behaviour="pass-through">
                        <desc>Birth date in individual register page</desc>
                        <param name="place" value="placeName"/>
                        <param name="date"
                            value="tp:format_date(xs:date(@when))"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="birth">✱ [[date]], [[place]]</span>
                        </pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="death" mode="change">
                    <model behaviour="pass-through">
                        <desc>Death date in individual register page</desc>
                        <param name="place" value="placeName"/>
                        <param name="date"
                            value="tp:format_date(xs:date(@when))"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="death">&#x271D; [[date]], [[place]]</span>
                        </pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="q" mode="change">
                    <model behaviour="inline" predicate="parent::note or ancestor::p" cssClass="inline-quote"/>
                    <model behaviour="block" cssClass="block-quote"/>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>
