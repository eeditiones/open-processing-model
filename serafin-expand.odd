target="#ref-item">item</gi></item><item><gi target="#ref-label">label</gi></item><item><gi target="#ref-note">note</gi></item><item><gi target="#ref-p">p</gi></item><item><gi target="#ref-publisher">publisher</gi></item><item><gi target="#ref-ref">ref</gi></item><item><gi target="#ref-resp">resp</gi></item><item><gi target="#ref-sic">sic</gi></item><item><gi target="#ref-term">term</gi></item><item><gi target="#ref-time">time</gi></item><item><gi target="#ref-title">title</gi></item><item><gi target="#ref-unclear">unclear</gi></item></list></item><item n="header"><list type="specItems"><item><gi target="#ref-change">change</gi></item><item><gi target="#ref-classCode">classCode</gi></item><item><gi target="#ref-correspAction">correspAction</gi></item><item><gi target="#ref-creation">creation</gi></item><item><gi target="#ref-edition">edition</gi></item><item><gi target="#ref-extent">extent</gi></item><item><gi target="#ref-language">language</gi></item><item><gi target="#ref-licence">licence</gi></item></list></item><item n="linking"><list type="specItems"><item><gi target="#ref-ab">ab</gi></item><item><gi target="#ref-seg">seg</gi></item></list></item><item n="msdescription"><list type="specItems"><item><gi target="#ref-repository">repository</gi></item></list></item><item n="namesdates"><list type="specItems"><item><gi target="#ref-orgName">orgName</gi></item><item><gi target="#ref-persName">persName</gi></item></list></item><item n="textstructure"><list type="specItems"><item><gi target="#ref-byline">byline</gi></item><item><gi target="#ref-dateline">dateline</gi></item><item><gi target="#ref-docAuthor">docAuthor</gi></item><item><gi target="#ref-docDate">docDate</gi></item><item><gi target="#ref-opener">opener</gi></item><item><gi target="#ref-salute">salute</gi></item><item><gi target="#ref-signed">signed</gi></item></list></item><item n="transcr"><list type="specItems"><item><gi target="#ref-supplied">supplied</gi></item><item><gi target="#ref-surplus">surplus</gi></item></list></item></list><div type="spec-section" n="ref-models"><head>Processing model</head><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="fo" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="print" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="docx" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@key and $parameters?mode='register-details'" behaviour="inline">
                        <param name="content" value="let $key:= head((@key, @ref)) return id($key, collection($global:register-root)/id('pb-places'))/placeName[@type='main']/string()"/>
                    </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="$parameters?display='browse' or $parameters?mode=('breadcrumb', 'toc', 'title')" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="$parameters?mode='register'" behaviour="pass-through">
                        <desc>Register sidebar</desc>
                        <param name="default" value="."/>
                        <param name="alternate" value="parent::place/note"/>
                        <param name="uri" value="$parameters?context-path || '/places/' || parent::place/@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="placeName context">
            <pb-popover>
                <span slot="default">[[content]]</span>
                <template slot="alternate">[[alternate]]</template>
            </pb-popover>
            </a></pb:template>
                    </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@type='variant'" behaviour="inline" cssClass="name variant"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="parent::place" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="ancestor::correspContext" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="epub" predicate="ancestor::place or ancestor::person or ancestor::org" behaviour="inline">
                        <desc>EPUB: inside a register entry, which is rendered as a footnote
                            aside itself. Resolving the reference again would nest an aside
                            inside an aside.</desc>
                    </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@key or @ref" behaviour="alternate" cssClass="placeName context">
                        <param name="default" value="."/>
                        <param name="alternate" value="let $key:= head((@key, @ref)), $resolved := id($key, collection($global:register-root)/id('pb-places')) return if (count($resolved)) then $resolved else $key"/>
                    </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" behaviour="inline"/></div><div type="spec-section" n="ref-examples"><head>Examples</head><exemplum xml:lang="en">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-placeName-egXML-ud">
      <placeName>
        <settlement>Rochester</settlement>
        <region>New York</region>
      </placeName>
    </egXML>
  </exemplum><exemplum versionDate="2008-04-06" xml:lang="fr">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-placeName-egXML-ko">
      <placeName>
