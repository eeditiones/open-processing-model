        <measure>十哩</measure>
      </placeName>
    </egXML>
  </exemplum><exemplum xml:lang="en">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-placeName-egXML-vi">
      <placeName>
