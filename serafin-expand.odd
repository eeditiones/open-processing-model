<gi target="#ref-item">item</gi></item><item><gi target="#ref-label">label</gi></item><item><gi target="#ref-note">note</gi></item><item><gi target="#ref-p">p</gi></item><item><gi target="#ref-publisher">publisher</gi></item><item><gi target="#ref-ref">ref</gi></item><item><gi target="#ref-resp">resp</gi></item><item><gi target="#ref-respStmt">respStmt</gi></item><item><gi target="#ref-sic">sic</gi></item><item><gi target="#ref-term">term</gi></item><item><gi target="#ref-time">time</gi></item><item><gi target="#ref-title">title</gi></item><item><gi target="#ref-unclear">unclear</gi></item></list></item><item n="header"><list type="specItems"><item><gi target="#ref-change">change</gi></item><item><gi target="#ref-classCode">classCode</gi></item><item><gi target="#ref-correspAction">correspAction</gi></item><item><gi target="#ref-creation">creation</gi></item><item><gi target="#ref-edition">edition</gi></item><item><gi target="#ref-extent">extent</gi></item><item><gi target="#ref-language">language</gi></item><item><gi target="#ref-licence">licence</gi></item></list></item><item n="linking"><list type="specItems"><item><gi target="#ref-ab">ab</gi></item><item><gi target="#ref-seg">seg</gi></item></list></item><item n="msdescription"><list type="specItems"><item><gi target="#ref-repository">repository</gi></item></list></item><item n="namesdates"><list type="specItems"><item><gi target="#ref-orgName">orgName</gi></item><item><gi target="#ref-placeName">placeName</gi></item></list></item><item n="textstructure"><list type="specItems"><item><gi target="#ref-byline">byline</gi></item><item><gi target="#ref-dateline">dateline</gi></item><item><gi target="#ref-docAuthor">docAuthor</gi></item><item><gi target="#ref-docDate">docDate</gi></item><item><gi target="#ref-opener">opener</gi></item><item><gi target="#ref-salute">salute</gi></item><item><gi target="#ref-signed">signed</gi></item></list></item><item n="transcr"><list type="specItems"><item><gi target="#ref-supplied">supplied</gi></item><item><gi target="#ref-surplus">surplus</gi></item></list></item></list><div type="spec-section" n="ref-models"><head>Processing model</head><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="fo" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="print" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="docx" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="(@key or @ref) and $parameters?mode='register-details'" behaviour="link">
            <param name="uri" value="head((@key, @ref))"/>
            <param name="target" value="'_blank'"/>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="pass-through"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="$parameters?mode='register'" behaviour="pass-through">
            <desc>Register sidebar</desc>
            <param name="content" value="."/>
            <param name="alternate" value="parent::person/note"/>
            <param name="uri" value="$parameters?context-path || '/people/' || parent::person/@xml:id"/>
            <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="persName">
                        <pb-popover>
                            <span slot="default">[[content]]</span>
                            <template slot="alternate">[[alternate]]</template>
                        </pb-popover>
                        </a></pb:template>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="$parameters?mode='register-overview'" behaviour="inline">
            <desc>When filtering/browsing the register, persons mentioned in descriptions, etc. are inlined</desc>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@type='variant'" behaviour="inline" cssClass="name variant"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="parent::person" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="ancestor::correspContext" behaviour="inline">
            <desc>do not resolve correspContext descriptions</desc>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="epub" predicate="ancestor::person or ancestor::place or ancestor::org" behaviour="inline">
                        <desc>EPUB: inside a register entry, which is rendered as a footnote
                            aside itself. Resolving the reference again would nest an aside
                            inside an aside.</desc>
                    </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@key or @ref" behaviour="alternate" cssClass="persName context">
            <param name="default" value="."/>
            <param name="alternate" value="let $key:= head((@key, @ref)), $resolved := id($key, collection($global:register-root)/id('pb-persons')) return if (count($resolved)) then $resolved else $key"/>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" behaviour="inline"/></div><div type="spec-section" n="ref-examples"><head>Examples</head><exemplum xml:lang="en">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-persName-egXML-mq">
      <persName><forename>Edward</forename><forename>George</forename><surname type="linked">Bulwer-Lytton</surname>, <roleName>Baron Lytton of
        <placeName>Knebworth</placeName>
            </roleName></persName>
    </egXML>
  </exemplum><exemplum versionDate="2017-06-23" xml:lang="fr">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-persName-egXML-lm">
      <persName> <surname>Poncet</surname> <forename>Olivier</forename> <roleName>professeur d'archivistique et diplomatique moderne</roleName> </persName>
    </egXML>
  </exemplum><exemplum versionDate="2017-06-23" xml:lang="fr">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-persName-egXML-fl">
  <persName> <forename>Joseph</forename> <addName type="stagename">Le Pétomane</addName> <surname>Pujol</surname> </persName> 
   </egXML>
  </exemplum><exemplum versionDate="2017-06-23" xml:lang="fr">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-persName-egXML-ud">
      <persName> <forename>Catherine</forename> <genName>II</genName>, <addName type="epithet"> la Grande</addName>, <roleName>impératrice de Russie</roleName> </persName>
    </egXML>
  </exemplum><exemplum xml:lang="zh-TW">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-persName-egXML-bm">
      <persName><forename>夏爾</forename><forename>皮耶</forename><surname>波特萊爾</surname>，<roleName><placeName>法國</placeName>象徵派詩人         </roleName>
         </persName>
    </egXML>
  </exemplum></div><div type="spec-section" n="ref-schema"><head>Content model</head><content>
    <macroRef key="macro.phraseSeq"/>
  </content></div></elementSpec><elementSpec xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron" module="msdescription" xml:id="ref-physDesc" ident="physDesc">
  <gloss versionDate="2007-07-04" xml:lang="en">physical description</gloss>
  <gloss versionDate="2007-12-20" xml:lang="ko">물리적 기술</gloss>
  <gloss versionDate="2007-05-02" xml:lang="zh-TW"/>
  <gloss versionDate="2008-04-06" xml:lang="es">descripción física</gloss>
  <gloss versionDate="2007-06-12" xml:lang="fr">description physique</gloss>
  <gloss versionDate="2007-11-06" xml:lang="it">descrizione fisica</gloss>
  <desc versionDate="2007-12-20" xml:lang="ko">model.physDescPart 클래스에서 더 특별화된 요소로 사용하기 위해 수의적으로 더 세분화한 원고 또는 원고 일부에 대한 완전한 물리적 기술을 포함한다.</desc>
  <desc versionDate="2007-05-02" xml:lang="zh-TW">包含一個手稿或手稿部分的完整材質描述，可以利用model.physDescPart class中的專門元素選擇性地再分類。</desc>
  <desc versionDate="2008-04-05" xml:lang="ja">手書き資料の物理的な解説を示す。選択的に、クラスmodel.physDescPartに
  ある要素に下位分解される。</desc>
  <desc versionDate="2007-06-12" xml:lang="fr">contient la description physique complète d'un
      manuscrit ou d'une partie d'un manuscrit, éventuellement structurée en utilisant les éléments
      plus spécialisés appartenant à la classe <ident type="class">model.physDescPart</ident>.</desc>
  <desc versionDate="2007-05-04" xml:lang="es">contiene una descripción física completa de un manuscrito o de una de sus partes que puede ser ulteriormente subdividida utilizando elementos específicos de la clase <ident type="class">model.physDescPart</ident>.</desc>
  <desc versionDate="2007-01-21" xml:lang="it">contiene una descrizione fisica completa di un manoscritto o di una sua parte che può essere ulteriormente suddivisa utilizzando elementi specifici della classe .physDescPart.</desc>
  <classes>
    <memberOf key="att.global"/>
    </classes>
  <listRef>
    <ptr target="#msph"/>
  </listRef>
<desc xmlns:pb="http://teipublisher.com/1.0">A sentence of prose on dimensions and condition ("209 × 260 mm; ślady
                        zawilgocenia…"). TEI's model.physDescPart — handDesc, bindingDesc,
                        decoDesc and the rest — is dropped; no letter carries one.</desc><list type="listRef"/><list type="attTree"><item><ident type="class" target="#ref-att.global">att.global</ident><list type="atts"><item ident="xml:id" n="att-xml-id">xml:id</item><item ident="n" n="att-n">n</item><item ident="xml:lang" n="att-xml-lang">xml:lang</item><item ident="xml:base" n="att-xml-base">xml:base</item><item ident="xml:space" n="att-xml-space">xml:space</item></list><list type="attTree"><item><ident type="class" target="#ref-att.global.analytic">att.global.analytic</ident><list type="atts"><item ident="ana" n="att-ana">ana</item></list></item><item><ident type="class" target="#ref-att.global.change">att.global.change</ident><list type="atts"><item ident="change" n="att-change">change</item></list></item><item><ident type="class" target="#ref-att.global.facs">att.global.facs</ident><list type="atts"><item ident="facs" n="att-facs">facs</item></list></item><item><ident type="class" target="#ref-att.global.linking">att.global.linking</ident><list type="atts"><item ident="corresp" n="att-corresp">corresp</item><item ident="synch" n="att-synch">synch</item><item ident="sameAs" n="att-sameAs">sameAs</item><item ident="copyOf" n="att-copyOf">copyOf</item><item ident="next" n="att-next">next</item><item ident="prev" n="att-prev">prev</item><item ident="exclude" n="att-exclude">exclude</item><item ident="select" n="att-select">select</item></list></item><item><ident type="class" target="#ref-att.global.rendition">att.global.rendition</ident><list type="atts"><item ident="rend" n="att-rend">rend</item><item ident="style" n="att-style">style</item><item ident="rendition" n="att-rendition">rendition</item></list></item><item><ident type="class" target="#ref-att.global.responsibility">att.global.responsibility</ident><list type="atts"><item ident="cert" n="att-cert">cert</item><item ident="resp" n="att-resp">resp</item></list></item><item><ident type="class" target="#ref-att.global.source">att.global.source</ident><list type="atts"><item ident="source" n="att-source">source</item></list></item></list></item></list><list type="memberOf"><item><ident type="class" target="#ref-att.global">att.global</ident></item></list><list type="mayContain"><item n="core"><list type="specItems"><item><gi target="#ref-p">p</gi></item></list></item><item n="linking"><list type="specItems"><item><gi target="#ref-ab">ab</gi></item></list></item></list><list type="containedBy"><item n="msdescription"><list type="specItems"><item><gi target="#ref-msDesc">msDesc</gi></item></list></item></list><div type="spec-section" n="ref-examples"><head>Examples</head><exemplum xml:lang="en">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="PHYSDESC-egXML-jp">
      <physDesc>
        <objectDesc form="codex">
          <supportDesc material="perg">
            <support>Parchment.</support>
            <extent>i + 55 leaves
                 <dimensions scope="all" type="leaf" unit="inch"><height>7¼</height><width>5⅜</width></dimensions>
                  </extent>
          </supportDesc>
          <layoutDesc>
            <layout columns="2">In double columns.</layout>
          </layoutDesc>
        </objectDesc>
        <handDesc>
          <p>Written in more than one hand.</p>
        </handDesc>
        <decoDesc>
          <p>With a few coloured capitals.</p>
        </decoDesc>
      </physDesc>
    </egXML>
  </exemplum></div><div type="spec-section" n="ref-schema"><head>Content model</head><content xmlns:pb="http://teipublisher.com/1.0">
                        <classRef key="model.pLike" minOccurs="1" maxOccurs="unbounded"/>
                    </content></div></elementSpec><elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:rng="http://relaxng.org/ns/structure/1.0" module="namesdates" xml:id="ref-placeName" ident="placeName">
  <gloss versionDate="2020-12-20" xml:lang="en">place name</gloss>
  <gloss versionDate="2008-12-09" xml:lang="fr">nom de lieu</gloss>
  <desc versionDate="2005-01-14" xml:lang="en">contains an absolute or relative place name.</desc>
  <desc versionDate="2007-12-20" xml:lang="ko">절대적 또는 상대적 위치명을 포함한다.</desc>
  <desc versionDate="2007-05-02" xml:lang="zh-TW">包含一個確切位置或相對位置的名稱。</desc>
  <desc versionDate="2008-04-05" xml:lang="ja">絶対的、相対的場所名を示す。</desc>
  <desc versionDate="2009-03-19" xml:lang="fr">contient un nom de lieu absolu ou relatif.</desc>
  <desc versionDate="2007-05-04" xml:lang="es">contiene la indicación absoluta o relativa de un nombre de lugar.</desc>
  <desc versionDate="2007-01-21" xml:lang="it">contiene l'indicazione assoluta o relativa di un nome di luogo.</desc>
  <classes>
    <memberOf key="att.global"/>
    <memberOf key="att.cmc"/>
    <memberOf key="att.datable"/>
    <memberOf key="att.editLike"/>
    <memberOf key="att.personal"/>
    <memberOf key="att.typed"/>
    <memberOf key="model.placeNamePart"/>
    <memberOf key="model.settingPart"/>
  </classes>
  <listRef>
    <ptr target="#NDPLAC"/>
  </listRef>
<list type="listRef"><item><ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDPLAC">NDPLAC</ref></item></list><list type="attTree"><item><ident type="class" target="#ref-att.global">att.global</ident><list type="atts"><item ident="xml:id" n="att-xml-id">xml:id</item><item ident="n" n="att-n">n</item><item ident="xml:lang" n="att-xml-lang">xml:lang</item><item ident="xml:base" n="att-xml-base">xml:base</item><item ident="xml:space" n="att-xml-space">xml:space</item></list><list type="attTree"><item><ident type="class" target="#ref-att.global.analytic">att.global.analytic</ident><list type="atts"><item ident="ana" n="att-ana">ana</item></list></item><item><ident type="class" target="#ref-att.global.change">att.global.change</ident><list type="atts"><item ident="change" n="att-change">change</item></list></item><item><ident type="class" target="#ref-att.global.facs">att.global.facs</ident><list type="atts"><item ident="facs" n="att-facs">facs</item></list></item><item><ident type="class" target="#ref-att.global.linking">att.global.linking</ident><list type="atts"><item ident="corresp" n="att-corresp">corresp</item><item ident="synch" n="att-synch">synch</item><item ident="sameAs" n="att-sameAs">sameAs</item><item ident="copyOf" n="att-copyOf">copyOf</item><item ident="next" n="att-next">next</item><item ident="prev" n="att-prev">prev</item><item ident="exclude" n="att-exclude">exclude</item><item ident="select" n="att-select">select</item></list></item><item><ident type="class" target="#ref-att.global.rendition">att.global.rendition</ident><list type="atts"><item ident="rend" n="att-rend">rend</item><item ident="style" n="att-style">style</item><item ident="rendition" n="att-rendition">rendition</item></list></item><item><ident type="class" target="#ref-att.global.responsibility">att.global.responsibility</ident><list type="atts"><item ident="cert" n="att-cert">cert</item><item ident="resp" n="att-resp">resp</item></list></item><item><ident typ