      </placeName>
    </egXML>
  </exemplum><exemplum xml:lang="zh-TW">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-placeName-egXML-oo">
      <placeName>
        <settlement>烏魯木齊</settlement>
