    </egXML>
  </exemplum><exemplum xml:lang="zh-TW">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-placeName-egXML-qt">
      <placeName>
        <geogName>天池</geogName>
