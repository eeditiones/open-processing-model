  </remarks></div></classSpec><classSpec xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron" module="tei" type="model" ident="model.divTop" xml:id="ref-model.divTop">
