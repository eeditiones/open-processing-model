i target="#ref-note">note</gi></item><item><gi target="#ref-p">p</gi></item><item><gi target="#ref-publisher">publisher</gi></item><item><gi target="#ref-ref">ref</gi></item><item><gi target="#ref-resp">resp</gi></item><item><gi target="#ref-respStmt">respStmt</gi></item><item><gi target="#ref-sic">sic</gi></item><item><gi target="#ref-term">term</gi></item><item><gi target="#ref-time">time</gi></item><item><gi target="#ref-title">title</gi></item><item><gi target="#ref-unclear">unclear</gi></item></list></item><item n="header"><list type="specItems"><item><gi target="#ref-change">change</gi></item><item><gi target="#ref-classCode">classCode</gi></item><item><gi target="#ref-correspAction">correspAction</gi></item><item><gi target="#ref-creation">creation</gi></item><item><gi target="#ref-edition">edition</gi></item><item><gi target="#ref-extent">extent</gi></item><item><gi target="#ref-language">language</gi></item><item><gi target="#ref-licence">licence</gi></item></list></item><item n="linking"><list type="specItems"><item><gi target="#ref-ab">ab</gi></item><item><gi target="#ref-seg">seg</gi></item></list></item><item n="msdescription"><list type="specItems"><item><gi target="#ref-repository">repository</gi></item></list></item><item n="namesdates"><list type="specItems"><item><gi target="#ref-persName">persName</gi></item><item><gi target="#ref-placeName">placeName</gi></item></list></item><item n="textstructure"><list type="specItems"><item><gi target="#ref-byline">byline</gi></item><item><gi target="#ref-dateline">dateline</gi></item><item><gi target="#ref-docAuthor">docAuthor</gi></item><item><gi target="#ref-docDate">docDate</gi></item><item><gi target="#ref-opener">opener</gi></item><item><gi target="#ref-salute">salute</gi></item><item><gi target="#ref-signed">signed</gi></item></list></item><item n="transcr"><list type="specItems"><item><gi target="#ref-supplied">supplied</gi></item><item><gi target="#ref-surplus">surplus</gi></item></list></item></list><div type="spec-section" n="ref-models"><head>Processing model</head><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="fo" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="print" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@key and $parameters?mode='register-details'" behaviour="inline">
            <param name="content" value="let $key:= head((@key, @ref)) return id($key, collection($global:register-root)/id('pb-organizations'))/placeName[@type='main']/string()"/>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="$parameters?mode='register'" behaviour="pass-through">
            <desc>Register sidebar</desc>
            <param name="default" value="."/>
            <param name="alternate" value="parent::org/note"/>
            <param name="uri" value="$parameters?context-path || '/organizations/' || parent::org/@xml:id"/>
            <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="orgName context">
            <pb-popover>
                <span slot="default">[[content]]</span>
                <template slot="alternate">[[alternate]]</template>
            </pb-popover>
            </a></pb:template>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@type='variant'" behaviour="inline" cssClass="name variant"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="parent::org" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="ancestor::correspContext" behaviour="inline"/><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" output="epub" predicate="ancestor::org or ancestor::person or ancestor::place" behaviour="inline">
                        <desc>EPUB: inside a register entry, which is rendered as a footnote
                            aside itself. Resolving the reference again would nest an aside
                            inside an aside.</desc>
                    </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" predicate="@key or @ref" behaviour="alternate" cssClass="orgName context">
            <param name="default" value="."/>
            <param name="alternate" value="let $key:= head((@key, @ref)) return id($key, collection($global:register-root)/id('pb-organizations'))"/>
        </model><model xmlns:mei="http://www.music-encoding.org/ns/mei" xmlns:pb="http://teipublisher.com/1.0" behaviour="inline"/></div><div type="spec-section" n="ref-examples"><head>Examples</head><exemplum xml:lang="en">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-orgName-egXML-qv">About a year back, a question of considerable interest was agitated in the <orgName key="PAS1" type="voluntary"><placeName key="PEN">Pennsyla.</placeName> Abolition Society</orgName> [...]</egXML>
  </exemplum><exemplum versionDate="2008-04-06" xml:lang="fr">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-orgName-egXML-zd">
      <orgName key="ssav" type="regional">Société savoisienne de <placeName key="GRE">Grenoble</placeName>
         </orgName>
    </egXML>
  </exemplum><exemplum xml:lang="zh-TW">
    <egXML xmlns="http://www.tei-c.org/ns/Examples" xml:id="gi-orgName-egXML-zj"> 大約一年前，在<placeName key="PEN">賓州</placeName>的<orgName key="PAS1" type="voluntary">廢止黑奴協會</orgName>，有一場轟動的激辯。</egXML>
  </exemplum></div><div type="spec-section" n="ref-schema"><head>Content model</head><content>
    <macroRef key="macro.phraseSeq"/>
  </content></div></elementSpec><elementSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:rng="http://relaxng.org/ns/structure/1.0" module="core" xml:id="ref-p" ident="p">
  <gloss versionDate="2005-01-14" xml:lang="en">paragraph</gloss>
  <gloss versionDate="2007-12-20" xml:lang="ko">문단</gloss>
  <gloss versionDate="2007-05-02" xml:lang="zh-TW">段落</gloss>
  <gloss versionDate="2009-01-06" xml:lang="fr">paragraphe</gloss>
  <gloss versionDate="2007-05-04" xml:lang="es">párrafo</gloss>
  <gloss versionDate="2007-01-21" xml:lang="it">paragrafo</gloss>
  <gloss versionDate="2016-11-24" xml:lang="de">Absatz</gloss>
  <desc versionDate="2005-01-14" xml:lang="en">marks paragraphs in prose.</desc>
  <desc versionDate="2007-12-20" xml:lang="ko">산문에서 문단을 표시한다.</desc>
  <desc versionDate="2007-05-02" xml:lang="zh-TW">標記散文的段落。</desc>
  <desc versionDate="2008-04-05" xml:lang="ja">散文の段落を示す。</desc>
  <desc versionDate="2009-01-06" xml:lang="fr">marque les paragraphes dans un texte en prose.</desc>
  <desc versionDate="2007-05-04" xml:lang="es">marca párrafos en prosa.</desc>
  <desc versionDate="2007-01-21" xml:lang="it">indica i paragrafi in prosa.</desc>
  <desc versionDate="2016-11-24" xml:lang="de">markiert einen Absatz in einem Prosatext.</desc>
