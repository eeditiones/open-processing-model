<list type="usedBy"><item><gi target="#ref-add">add</gi><seg type="module">core</seg></item><item><gi target="#ref-corr">corr</gi><seg type="module">core</seg></item><item><gi target="#ref-del">del</gi><seg type="module">core</seg></item><item><gi target="#ref-emph">emph</gi><seg type="module">core</seg></item><item><gi target="#ref-hi">hi</gi><seg type="module">core</seg></item><item><gi target="#ref-p">p</gi><seg type="module">core</seg></item><item><gi target="#ref-ref">ref</gi><seg type="module">core</seg></item><item><gi target="#ref-salute">salute</gi><seg type="module">textstructure</seg></item><item><gi target="#ref-seg">seg</gi><seg type="module">linking</seg></item><item><gi target="#ref-sic">sic</gi><seg type="module">core</seg></item><item><gi target="#ref-signed">signed</gi><seg type="module">textstructure</seg></item><item><gi target="#ref-supplied">supplied</gi><seg type="module">transcr</seg></item><item><gi target="#ref-surplus">surplus</gi><seg type="module">transcr</seg></item><item><gi target="#ref-title">title</gi><seg type="module">core</seg></item><item><gi target="#ref-unclear">unclear</gi><seg type="module">core</seg></item></list><div type="spec-section" n="ref-schema"><head>Content model</head><content>    
