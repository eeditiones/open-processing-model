  <desc versionDate="2007-05-04" xml:lang="es">define el contenido de elementos de prosa que no se usan para la transcripción de materiales existentes.</desc>
  <listRef>
    <ptr target="#STEC"/>
  </listRef>
<list type="usedBy"><item><gi target="#ref-desc">desc</gi><seg type="module">core</seg></item></list><div type="spec-section" n="ref-schema"><head>Content model</head><content>
    
