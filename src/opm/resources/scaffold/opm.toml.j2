[project]
pythonpath = ["."]

[transform]
odd = "{{ odd_path }}"
xpath_extensions = [
    "opm.runtime.common_xpath_functions"
]

# Prefixes for XPath written inside the ODD. `global` is what teipublisher.odd
# uses for its eXist-side settings; binding it here rather than in the ODD keeps
# these values a property of the project, not of the ODD.
[transform.namespaces]
global = "http://teipublisher.com/global"

# Values for those settings, grouped by the prefix declared above. Until a
# variable is given a value here (and, for the collection ones, a matching
# [[transform.collections]] below), models that use it fall back to rendering the
# element itself — which is what standalone opm projects have always done.
[transform.variables.global]
# Register of persons/places/organisations, resolved as collection($global:register-root).
# Any absolute URI works; this is just an opaque key that has to match the
# [[transform.collections]] uri below. Porting from eXist? Paste that app's
# $config:register-root here verbatim and the ODD needs no changes.
register-root = "urn:registers"

# Point a collection URI at the files it contains. Uncomment and list your
# register files to make collection($global:register-root) resolve. `uri` must
# match register-root above; the files themselves come from `documents`.
# [[transform.collections]]
# uri = "urn:registers"
# documents = [
#     "data/registers/persons.xml",
#     "data/registers/places.xml",
# ]

[transform.web.webcomponents]
enabled = {{ 'true' if webcomponents else 'false' }}

# Anything here reaches every Jinja2 template as `context` — templates only,
# never XPath — so TOML types survive: booleans, numbers, arrays, sub-tables.
# Read it as {{ '{{ context.site_name }}' }} or {% raw %}{% if context.show_downloads %}{% endraw %}.
# [context]
# site_name = "My edition"
# show_downloads = true
#
# A [transform.<type>.context] table overlays this for one output type only:
# [transform.typst.context]
# paper = "a5"

{% if 'docx' in outputs -%}
[transform.docx]
template = "templates/default.docx"
{% endif %}
{% if 'typst' in outputs -%}
[transform.typst]
template = "{{ typst_template }}"
{% endif %}
{% if 'markdown' in outputs -%}
[transform.markdown]
# Optional per-type ODD override: odd = "{{ odd_path }}"
{% endif %}
[document]
template = "templates/{{ html_template }}.html.j2"
# Your own stylesheet, layered over the ODD's. The rules every ODD-rendered
# document needs are already part of the ODD stylesheet, so this is for
# project-specific overrides only.
# css = "styles/custom.css"

{% if chunk_selector -%}
[chunking]
selector = "{{ chunk_selector }}"
depth = {{ chunk_depth }}
output_dir = "chunks"
template = "templates/{{ html_template }}.html.j2"

[[chunking.fragments]]
name = "title"
scope = "global"
xpath = "{{ title_xpath }}"
parameters = { mode = "title" }

{% if breadcrumbs -%}
[[chunking.fragments]]
name = "breadcrumbs"
scope = "per-chunk"
xpath = "."
parameters = { mode = "breadcrumb" }
{% endif -%}
{% endif -%}

[index]
# `opm index` rolls the ODD's own output up into JSONL records for a search
# index or vector store. The defaults suit prose; uncomment to tune.
# max_chars = 1500   # split a passage longer than this
# min_chars = 40     # drop units shorter than this; a bare heading is noise
# overlap = 1        # records of context carried into the next part on a split

# Material pulled out of a passage, selected by `elements`, `behaviours` or
# `models`. A facet stays in the prose and is repeated as metadata you can
# filter on:
#
# [[index.fields]]
# name = "persons"
# elements = ["{{ index_name_element }}"]
#
# With metadata = false each match becomes a record of its own instead, tagged
# kind = "note" and linked to the passage it came from, and it leaves that
# passage's text (inline = true keeps it in both places):
#
# [[index.fields]]
# name = "note"
# elements = ["{{ index_note_element }}"]
# metadata = false
