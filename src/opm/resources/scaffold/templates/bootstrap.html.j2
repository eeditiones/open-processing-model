<!doctype html>
<html lang="{{ lang|default('en') }}" data-bs-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- bootstrap template -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  >
  {{ head_html | safe }}
  {% if odd_css %}
  <style type="text/css">
{{ odd_css }}
  </style>
  {% endif %}
  {% if context.webcomponents_url %}
  <script type="module" src="{{ context.webcomponents_url }}"></script>
  {% endif %}
</head>
<body>
  <header class="border-bottom mb-4">
    <nav class="navbar navbar-expand-lg container py-3">
      <span class="navbar-brand fw-semibold mb-0 h1">TEI Publisher Preview</span>
    </nav>
  </header>
  <main class="container my-4 content">
    {{ content_html | safe }}
  </main>
  {% if chunk is defined and (chunk.prev or chunk.next) %}
  <footer class="border-top mt-4 py-3">
    <nav class="container d-flex justify-content-between">
      {% if chunk.prev %}
      <a href="{{ chunk.prev }}.html" class="btn btn-outline-secondary">&lsaquo; Previous</a>
      {% else %}
      <span></span>
      {% endif %}
      {% if chunk.next %}
      <a href="{{ chunk.next }}.html" class="btn btn-outline-secondary">Next &rsaquo;</a>
      {% endif %}
    </nav>
  </footer>
  {% endif %}
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>
</body>
</html>
