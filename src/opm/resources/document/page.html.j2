<!doctype html>
<html lang="{{ context.lang|default(lang or 'en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if chunk.xml_id and chunk.xml_id != 'index' %}{{ chunk.xml_id }} — {% endif %}{{ context.site_title }}</title>
  <link rel="stylesheet" href="document.css">
  {% if odd_css_url %}<link rel="stylesheet" href="{{ odd_css_url }}">{% endif %}
  <script src="theme.js"></script>
</head>
<body class="doc{% if fragments.nav %} doc--with-nav{% endif %}">
  <a class="doc-skip" href="#doc-content">Skip to content</a>
  <header class="doc-header">
    <a class="doc-brand" href="index.html">
      <img class="doc-brand__logo" src="tei-logo.svg" alt="TEI" width="30" height="30">
      <span class="doc-brand__title">{{ context.site_title }}</span>
    </a>
    {% if context.edition %}<span class="doc-edition">{{ context.edition }}</span>{% endif %}
    <span class="doc-header__spacer"></span>
    <form class="doc-search" role="search" data-idents="idents.json">
      <label class="visually-hidden" for="doc-q">Find an element, class or macro</label>
      <input id="doc-q" type="search" placeholder="p, att.global, model.pLike…" autocomplete="off">
      <ul class="doc-search__hits" hidden></ul>
    </form>
    <button class="doc-theme" type="button" data-doc-theme hidden aria-label="Switch theme">
      <svg class="doc-theme__moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
              d="M15.2 3.6A8.6 8.6 0 1 0 20.4 14 6.8 6.8 0 0 1 15.2 3.6z"/>
      </svg>
      <svg class="doc-theme__sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
              d="M12 3.2v1.8M12 19v1.8M4.9 4.9l1.3 1.3M17.8 17.8l1.3 1.3M3.2 12h1.8M19 12h1.8M4.9 19.1l1.3-1.3M17.8 6.2l1.3-1.3"/>
      </svg>
    </button>
  </header>
  <div class="doc-shell">
    {% if fragments.nav %}
    <aside class="doc-sidebar" aria-label="Site">
      <nav>
        <p class="doc-sidebar__label">Contents</p>
        {{ fragments.nav | replace('href="' ~ chunk.file ~ '"', 'href="' ~ chunk.file ~ '" aria-current="page"') | safe }}
      </nav>
    </aside>
    {% endif %}
    <main class="doc-main" id="doc-content">
      {{ content_html | safe }}
      {% if fragments.chapterend %}{{ fragments.chapterend | safe }}{% endif %}
    </main>
    <aside class="doc-aside" aria-label="On this page" data-page-toc>
      <p class="doc-aside__label">On this page</p>
      <ul></ul>
      {% if fragments.chapternav %}{{ fragments.chapternav | safe }}{% endif %}
    </aside>
  </div>
  <footer class="doc-footer">
    <span>{{ context.site_title }}{% if context.edition %} · {{ context.edition }}{% endif %}</span>
    {% if context.rights %}<span>{{ context.rights }}</span>{% endif %}
  </footer>
  <script src="search.js" defer></script>
</body>
</html>
