{#-
  Page layout with the regions of the jinks base layout:

      header      (full width, sticky)
      hero        (full width)
      before-top  content-top  after-top
      before      content      after
      footer      (full width)

  Fill a region by overriding the block of the same name (with underscores:
  before_top, content_top, after_top). A region left empty takes no room.
  The content block defaults to the transformed document.

  The header and the content-top region are written by the layout, as in
  jinks, so a template fills slots in them instead of replacing them:

      header       menubar: logo, context.menu.items, menu_left |
                   menu_toggles, drawer triggers; then the header block
      content-top  toolbar: breadcrumb | toggle, prev/next, toolbar;
                   then the content_top block

  logo defaults to context.logo, context.author and the title (a child's
  `work_title`, context.site_name, context.title or the index `title`);
  breadcrumb to the `breadcrumbs` fragment. menu_left, menu_toggles, toggle
  and toolbar take <li> items. Theme via --opm-surface / --opm-ink and
  related variables in opm-layout.css.

  Settings, under `layout` in the context (defaults in opm/defaults.toml,
  overridden by opm.toml [context] and then by template frontmatter):
    layout.class          extra classes on the layout container
    layout.before.width   width of the before column (CSS length)
    layout.before.mobile  "drawer" (slides in, opened from content-top) or
                          "stack" (shown below the content)
    layout.before.label   label of the drawer's open button
    layout.after.*        the same for the after column
    menu.items            links after the logo: [{ label, url }]
    features.menubar      false drops the menubar (the header block stays)
    features.toolbar.enabled     false drops the toolbar
    features.toolbar.navigation  previous/next links for chunk pages
-#}
{% extends "opm/base.html.j2" %}

{% block layout_styles %}
  {% if layout_css_url %}
  <link rel="stylesheet" href="{{ layout_css_url }}">
  {% else %}
  <style type="text/css">
{% include "opm/opm-layout.css" %}
  </style>
  {% endif %}
{% endblock %}

{% block body %}
{%- set L = context.layout %}
{#- Widths set in opm.toml or frontmatter go on the grid itself, so they win
    over a theme stylesheet's own default for the same property. #}
{%- set widths = [] %}
{%- if L.before.width %}{% set _ = widths.append('--opm-layout-before-width: ' ~ L.before.width ~ ';') %}{% endif %}
{%- if L.after.width %}{% set _ = widths.append('--opm-layout-after-width: ' ~ L.after.width ~ ';') %}{% endif %}
{%- set F = context.features %}
{#- Each block rendered once and trimmed, so an empty region can be left out. -#}
{%- set blocks = trimmed(self) %}
{%- set before_drawer = blocks.before and L.before.mobile == 'drawer' %}
{%- set after_drawer = blocks.after and L.after.mobile == 'drawer' %}
{%- set menu_items = context.menu['items'] or [] %}
{%- set show_menubar = F.menubar and (blocks.logo or menu_items or blocks.menu_left or blocks.menu_toggles or before_drawer or after_drawer) %}
{#- The links that open the drawers: in the menubar, or in the toolbar without one. -#}
{%- set triggers_html -%}
  {%- if before_drawer %}<li class="trigger"><label for="opm-before-toggle" class="opm-drawer__open opm-drawer__open--before">{{ L.before.label }}</label></li>{% endif %}
  {%- if after_drawer %}<li class="trigger"><label for="opm-after-toggle" class="opm-drawer__open opm-drawer__open--after">{{ L.after.label }}</label></li>{% endif %}
{%- endset %}
{%- set navigation_html -%}
  {%- if F.toolbar.navigation and chunk is defined and chunk and (chunk.prev or chunk.next) %}
  <li class="toolbar__navigation">
    {%- if chunk.prev %}<a href="{{ chunk.prev }}.html" rel="prev">&#8592; {{ L.previous_label }}</a>{% endif %}
    {%- if chunk.next %}<a href="{{ chunk.next }}.html" rel="next">{{ L.next_label }} &#8594;</a>{% endif %}
  </li>
  {%- endif %}
{%- endset %}
{%- set toolbar_end_html = blocks.toggle ~ navigation_html ~ blocks.toolbar ~ ('' if show_menubar else triggers_html) %}
{%- set show_toolbar = F.toolbar.enabled and (blocks.breadcrumb or toolbar_end_html | trim) %}
<div class="opm-layout
  {%- if L.class %} {{ L.class }}{% endif %}
  {%- if blocks.before %} has-before opm-before--{{ 'drawer' if before_drawer else 'stack' }}{% endif %}
  {%- if blocks.after %} has-after opm-after--{{ 'drawer' if after_drawer else 'stack' }}{% endif %}"
  {%- if widths %} style="{{ widths | join(' ') }}"{% endif %}>
  <a class="opm-skip" href="#opm-content">{{ L.skip_label }}</a>
  {%- if before_drawer %}
  <input type="checkbox" id="opm-before-toggle" class="opm-drawer__toggle" autocomplete="off">
  {%- endif %}
  {%- if after_drawer %}
  <input type="checkbox" id="opm-after-toggle" class="opm-drawer__toggle" autocomplete="off">
  {%- endif %}

  {%- if show_menubar or blocks.header %}
  <header class="page-header">
    {%- if show_menubar %}
    <nav class="menubar" aria-label="Site">
      <ul>
        {%- if blocks.logo %}
        <li class="logo">{{ blocks.logo }}</li>
        {%- endif %}
        {%- for item in menu_items %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        {{ blocks.menu_left }}
      </ul>
      <ul>
        {{ blocks.menu_toggles }}
        {{ triggers_html }}
      </ul>
    </nav>
    {%- endif %}
    {{ blocks.header }}
  </header>
  {%- endif %}

  {%- if blocks.hero %}
  <div class="hero">
    {{ blocks.hero }}
  </div>
  {%- endif %}

  {%- if blocks.before_top %}
  <nav class="before-top">
    {{ blocks.before_top }}
  </nav>
  {%- endif %}

  {%- if blocks.before %}
  <aside class="before" id="opm-before">
    {%- if before_drawer %}
    <div class="opm-drawer__head">
      <span class="opm-drawer__title">{{ L.before.label }}</span>
      <label for="opm-before-toggle" class="opm-drawer__close">{{ L.close_label }}</label>
    </div>
    {%- endif %}
    {{ blocks.before }}
  </aside>
  {%- endif %}

  {%- if show_toolbar or blocks.content_top %}
  <header class="content-top">
    {%- if show_toolbar %}
    <nav class="toolbar" aria-label="Toolbar">
      <div class="breadcrumb">{{ blocks.breadcrumb }}</div>
      {%- if toolbar_end_html | trim %}
      <ul>
        {{ toolbar_end_html }}
      </ul>
      {%- endif %}
    </nav>
    {%- endif %}
    {{ blocks.content_top }}
  </header>
  {%- endif %}

  <main class="opm-main" id="opm-content">
    {% block content %}
    <article class="content">
      {{ content_html | default('', true) | safe }}
    </article>
    {% endblock %}
  </main>

  {%- if blocks.after_top %}
  <nav class="after-top">
    {{ blocks.after_top }}
  </nav>
  {%- endif %}

  {%- if blocks.after %}
  <aside class="after" id="opm-after">
    {%- if after_drawer %}
    <div class="opm-drawer__head">
      <span class="opm-drawer__title">{{ L.after.label }}</span>
      <label for="opm-after-toggle" class="opm-drawer__close">{{ L.close_label }}</label>
    </div>
    {%- endif %}
    {{ blocks.after }}
  </aside>
  {%- endif %}

  {%- if blocks.footer %}
  <footer class="page-footer">
    {{ blocks.footer }}
  </footer>
  {%- endif %}

  {%- if before_drawer or after_drawer %}
  <div class="opm-drawer__backdrop" aria-hidden="true">
    {%- if before_drawer %}<label for="opm-before-toggle"></label>{% endif %}
    {%- if after_drawer %}<label for="opm-after-toggle"></label>{% endif %}
  </div>
  {%- endif %}
</div>
{#- The regions' blocks, rendered above and placed where they belong. -#}
{%- if false %}
{% block header %}{% endblock %}
{% block logo %}
{#- Resolved here (not at template top) so a child's `{% set work_title %}`
    after extends is visible when this block runs. -#}
{%- import "opm/brand.html.j2" as brand -%}
{%- set logo_src = brand.logo_src(context.logo, assets) | trim -%}
{%- set logo_title = work_title or context.site_name or context.title or title -%}
{%- if logo_src or context.author or logo_title %}
<a href="{{ context.home_url or index_url or 'index.html' }}">
  {%- if logo_src %}<img class="logo__image" src="{{ logo_src }}" alt="">{% endif %}
  {%- if context.author %}<span class="logo__author">{{ context.author }}</span>{% endif %}
  {%- if logo_title %}<span class="logo__title">{{ logo_title }}</span>{% endif %}
</a>
{%- endif %}
{% endblock %}
{% block menu_left %}{% endblock %}
{% block menu_toggles %}{% endblock %}
{% block breadcrumb %}{% if fragments is defined and fragments.breadcrumbs %}{{ fragments.breadcrumbs | safe }}{% endif %}{% endblock %}
{% block toggle %}{% endblock %}
{% block toolbar %}{% endblock %}
{% block hero %}{% endblock %}
{% block before_top %}{% endblock %}
{% block before %}{% endblock %}
{% block content_top %}{% endblock %}
{% block after_top %}{% endblock %}
{% block after %}{% endblock %}
{% block footer %}{% endblock %}
{% endif %}
{%- endblock %}
