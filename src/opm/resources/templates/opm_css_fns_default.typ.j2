// Default handlers for ODD @cssClass names. Extend in a project template, e.g.:
//   #let opm-css-fns = opm-css-fns + ( center: (body) => align(center, body), )
//
// Margin notes use the marginalia package; templates must apply
// ``#show: marginalia.setup.with(...)`` (see default_document.typ.j2).
#import "@preview/marginalia:0.3.1" as marginalia: note

// Outer margin reserved for margin notes by the ``marginalia.setup`` call each
// template makes. That call overrides any ``#set page(margin: …)`` above it, so
// these three numbers, not the page rule, decide the measure.
//
// They used to reserve ~5cm, which is right for a Tufte-style edition but is
// dead space otherwise — and no ODD shipped with opm emits a margin note, since
// ``note`` places a footnote unless a model passes place="margin". Widen these
// if yours does; a note is set into ``width``.
#let opm-margin-note-width = 2cm
#let opm-margin-note-sep = 0.5em
#let opm-margin-note-far = 1cm

#let opm-marginnote = note.with(
  counter: none,
  shift: false,
  side: "outer",
  text-style: (size: 0.75em, fill: luma(80)),
  // A column this narrow justifies into wide gaps; set it ragged.
  par-style: (justify: false),
)

// A marked note shows the source's marker (@n) before its text and at its
// anchor. marginalia only prints markers for a note with a counter; the
// counter's value is ignored. Marked notes sit close together (a, b, … on
// neighbouring lines), so they may shift to avoid one another.
#let opm-marginnote-marked(marker, body) = opm-marginnote(
  counter: marginalia.notecounter,
  numbering: (..) => [#super(marker)#h(0.25em)],
  anchor-numbering: (..) => super(marker),
  shift: true,
  body,
)

#let opm-css-fns = (
  pb: (body) => {
    pagebreak(weak: true)
    body
  },
  marginnote: (body, marker: none) => if marker == none {
    opm-marginnote(body)
  } else {
    opm-marginnote-marked(marker, body)
  },
)

// A pointer into the document (`#id` in the source): a link to its label when
// the document carries one, else just the text. A link to a missing label
// aborts `typst compile`, and not every id a source points at gets a label.
#let opm-xref(id, body) = context {
  let target = label(id)
  if query(target).len() > 0 { link(target, body) } else { body }
}

// Missing image files abort `typst compile`. Shadow `image` with a layout-retry
// helper (laurmaedje): the first pass tries `std.image`; if that fails, later
// passes substitute a placeholder. After this point `#set image(...)` must use
// `std.image` instead.
#let image(source, ..args) = context {
  let key = str(source)
  let path-label = label(key)
  let first-time = query((context {}).func()).len() == 0
  if first-time or query(path-label).len() > 0 {
    [#std.image(source, ..args)#path-label]
  } else {
    block(
      width: 100%,
      inset: 0.75em,
      fill: luma(235),
      stroke: 0.5pt + luma(180),
    )[
      #set align(center)
      #set text(size: 0.85em, fill: luma(90))
      Missing image: #raw(key)
    ]
  }
}
