<?xml-model href="teipublisher_odds.xsd"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0"
     xmlns:eg="http://www.tei-c.org/ns/Examples"
     xmlns:mei="http://www.music-encoding.org/ns/mei"
     xmlns:pb="http://teipublisher.com/1.0"
     xmlns:opm="http://teipublisher.com/opm/1.0"
     xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>ODD documentation
                    <desc>Processing models for schema documentation (tagdocs)</desc>
                </title>
            </titleStmt>
            <publicationStmt>
                <publisher>e-editiones</publisher>
                <availability>
                    <licence target="https://creativecommons.org/licenses/by/4.0/">Distributed under a
                        Creative Commons Attribution 4.0 International License</licence>
                    <p>Copyright 2026 <ref target="https://e-editiones.org">e-editiones</ref>.</p>
                    <p>Based on TEI materials © TEI Consortium (CC BY 3.0 / BSD-2-Clause).</p>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Processing ODD used by <code>opm odd document</code> to render nested TEI in
                    specification fields and Guidelines chapters.</p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <tagsDecl>
                <rendition source="tagdocs.css"/>
            </tagsDecl>
        </encodingDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec ident="tagdocs" start="TEI teiCorpus" source="teipublisher.odd">
                <elementSpec ident="text" mode="change">
                    <desc>Guidelines table of contents: top-level chapter divs only.</desc>
                    <model predicate="$parameters?mode='toc'" behaviour="list" cssClass="toc">
                        <param name="content" value="(front|body|back)/div[@opm:page='chapter']"/>
                    </model>
                    <model behaviour="body"/>
                </elementSpec>
                <elementSpec ident="div" mode="change">
                    <desc>In toc mode, headed nested divs become linked list items
                        (chapter file for top-level, fragment id otherwise).</desc>
                    <model predicate="@opm:page='home'" behaviour="pass-through">
                        <param name="title" value="normalize-space((head, root($parameters?root)/*/teiHeader/fileDesc/titleStmt/title, @xml:id)[1])"/>
                        <param name="blurb" value="titlePage | p | opener | epigraph"/>
                        <!-- The release line from the header, under the title page's own
                             byline: "P5 Version 4.12.0. Last updated on …". Flattened to
                             text because the Guidelines link parts of it to pages that
                             only exist in TEI's own build. -->
                        <param name="edition" value="normalize-space(root($parameters?root)/*/teiHeader/fileDesc/editionStmt/edition)"/>
                        <param name="lead" value="if (empty((titlePage, p, opener, epigraph))) then 'Reference documentation generated from the ODD.' else ''"/>
                        <param name="toc" value="tp:guidelines_toc(.)"/>
                        <param name="nElements" value="tp:spec_count('element', .)"/>
                        <param name="nModel" value="tp:spec_count('model', .)"/>
                        <param name="nAtts" value="tp:spec_count('atts', .)"/>
                        <param name="nAttributes" value="tp:spec_count('attributes', .)"/>
                        <param name="nMacros" value="tp:spec_count('macro', .)"/>
                        <pb:template xmlns=""><section class="home"><h1>[[title]]</h1>[[blurb]]<p class="home-edition">[[edition]]</p><p class="lead">[[lead]]</p>[[toc]]<h2>Reference</h2><ul class="toc"><li><a href="REF-ELEMENTS.html">Elements</a> <span class="muted">[[nElements]]</span></li><li><a href="REF-CLASSES-MODEL.html">Model classes</a> <span class="muted">[[nModel]]</span></li><li><a href="REF-CLASSES-ATTS.html">Attribute classes</a> <span class="muted">[[nAtts]]</span></li><li><a href="REF-ATTS.html">Attributes</a> <span class="muted">[[nAttributes]]</span></li><li><a href="REF-MACROS.html">Macros and datatypes</a> <span class="muted">[[nMacros]]</span></li></ul></section></pb:template>
                    </model>
                    <model predicate="@opm:page='catalog'" behaviour="pass-through">
                        <param name="heading" value="normalize-space(head)"/>
                        <param name="number" value="tp:heading_mark(.)"/>
                        <param name="catalog" value="tp:spec_catalog(@subtype, .)"/>
                        <pb:template xmlns=""><section class="catalog"><h1>[[number]][[heading]]</h1>[[catalog]]</section></pb:template>
                    </model>
                    <model predicate="@opm:page='atts'" behaviour="pass-through">
                        <param name="number" value="tp:heading_mark(.)"/>
                        <param name="catalog" value="tp:attribute_catalog(.)"/>
                        <pb:template xmlns=""><section class="catalog"><h1>[[number]]Attributes</h1>[[catalog]]</section></pb:template>
                    </model>
                    <model predicate="@type='guidelines-toc' and count(list)=1" behaviour="pass-through">
                        <param name="content" value="list"/>
                        <pb:template xmlns=""><h2>Guidelines</h2>[[content]]</pb:template>
                    </model>
                    <model predicate="@type='guidelines-toc'" behaviour="pass-through">
                        <param name="content" value="list"/>
                    </model>
                    <model predicate="@type='spec-section' and @n='ref-models'" behaviour="pass-through">
                        <param name="heading" value="normalize-space(head)"/>
                        <param name="anchor" value="@n"/>
                        <param name="content" value="*[not(self::head)]"/>
                        <pb:template xmlns=""><section class="spec-section" id="[[anchor]]"><h2>[[heading]]</h2><ol class="pm">[[content]]</ol></section></pb:template>
                    </model>
                    <model predicate="@type='spec-section'" behaviour="pass-through">
                        <param name="heading" value="normalize-space(head)"/>
                        <param name="anchor" value="@n"/>
                        <param name="content" value="*[not(self::head)]"/>
                        <pb:template xmlns=""><section class="spec-section" id="[[anchor]]"><h2>[[heading]]</h2>[[content]]</section></pb:template>
                    </model>
                    <model predicate="$parameters?mode='toc' and div[head]" behaviour="listItem">
                        <param name="uri" value="concat(ancestor-or-self::div[parent::body or parent::front or parent::back][1]/@xml:id, '.html', if (parent::body or parent::front or parent::back) then '' else concat('#', @xml:id))"/>
                        <param name="head" value="head"/>
                        <param name="content" value="div[head]"/>
                        <pb:template xmlns=""><a href="[[uri]]">[[head]]</a><ul class="toc">[[content]]</ul></pb:template>
                    </model>
                    <model predicate="$parameters?mode='toc'" behaviour="listItem">
                        <param name="uri" value="concat(ancestor-or-self::div[parent::body or parent::front or parent::back][1]/@xml:id, '.html', if (parent::body or parent::front or parent::back) then '' else concat('#', @xml:id))"/>
                        <param name="head" value="head"/>
                        <pb:template xmlns=""><a href="[[uri]]">[[head]]</a></pb:template>
                    </model>
                    <!-- Compact previous/next pair for the right-hand rail, under the
                         on-this-page list. Emitted as the per-chunk `chapternav` fragment,
                         so the chapter body itself is not re-rendered here. -->
                    <model predicate="$parameters?mode='chapnav' and @opm:page='chapter'" behaviour="pass-through">
                        <param name="prevHref" value="let $p := preceding::div[@opm:page='chapter'][1] return if (exists($p/@xml:id)) then concat($p/@xml:id, '.html') else ''"/>
                        <param name="prevTitle" value="let $p := preceding::div[@opm:page='chapter'][1] return if (exists($p/head)) then normalize-space($p/head[1]) else ''"/>
                        <param name="prevNum" value="let $p := preceding::div[@opm:page='chapter'][1] return tp:heading_label($p)"/>
                        <param name="nextHref" value="let $n := following::div[@opm:page='chapter'][1] return if (exists($n/@xml:id)) then concat($n/@xml:id, '.html') else ''"/>
                        <param name="nextTitle" value="let $n := following::div[@opm:page='chapter'][1] return if (exists($n/head)) then normalize-space($n/head[1]) else ''"/>
                        <param name="nextNum" value="let $n := following::div[@opm:page='chapter'][1] return tp:heading_label($n)"/>
                        <pb:template xmlns=""><nav class="chapter-nav chapter-nav--rail" aria-label="Chapter"><a class="chapter-nav__prev" href="[[prevHref]]" rel="prev"><span class="chapter-nav__label">Previous</span><span class="chapter-nav__title"><span class="chapter-nav__num">[[prevNum]]</span>[[prevTitle]]</span></a><a class="chapter-nav__next" href="[[nextHref]]" rel="next"><span class="chapter-nav__label">Next</span><span class="chapter-nav__title"><span class="chapter-nav__num">[[nextNum]]</span>[[nextTitle]]</span></a></nav></pb:template>
                    </model>
                    <!-- Full-width previous/next cards closing the chapter. Kept out of the
                         chunk body so the runtime appends footnotes to the article, above
                         these links, rather than into the card grid. -->
                    <model predicate="$parameters?mode='chapnav-end' and @opm:page='chapter'" behaviour="pass-through">
                        <param name="prevHref" value="let $p := preceding::div[@opm:page='chapter'][1] return if (exists($p/@xml:id)) then concat($p/@xml:id, '.html') else ''"/>
                        <param name="prevTitle" value="let $p := preceding::div[@opm:page='chapter'][1] return if (exists($p/head)) then normalize-space($p/head[1]) else ''"/>
                        <param name="prevNum" value="let $p := preceding::div[@opm:page='chapter'][1] return tp:heading_label($p)"/>
                        <param name="nextHref" value="let $n := following::div[@opm:page='chapter'][1] return if (exists($n/@xml:id)) then concat($n/@xml:id, '.html') else ''"/>
                        <param name="nextTitle" value="let $n := following::div[@opm:page='chapter'][1] return if (exists($n/head)) then normalize-space($n/head[1]) else ''"/>
                        <param name="nextNum" value="let $n := following::div[@opm:page='chapter'][1] return tp:heading_label($n)"/>
                        <pb:template xmlns=""><nav class="chapter-nav" aria-label="Chapter navigation"><a class="chapter-nav__prev" href="[[prevHref]]" rel="prev"><span class="chapter-nav__label">Previous chapter</span><span class="chapter-nav__title"><span class="chapter-nav__num">[[prevNum]]</span>[[prevTitle]]</span></a><a class="chapter-nav__next" href="[[nextHref]]" rel="next"><span class="chapter-nav__label">Next chapter</span><span class="chapter-nav__title"><span class="chapter-nav__num">[[nextNum]]</span>[[nextTitle]]</span></a></nav></pb:template>
                    </model>
                    <model predicate="@opm:page='chapter'" behaviour="pass-through">
                        <param name="content" value="if (titlePage) then *[not(self::head)] else *"/>
                        <pb:template xmlns=""><article class="doc-chapter">[[content]]</article></pb:template>
                    </model>
                    <model predicate="parent::body or parent::front or parent::back" behaviour="section"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="head" mode="change">
                    <model predicate="$parameters?mode=('toc', 'nav')" behaviour="inline"/>
                    <model predicate="parent::figure" behaviour="block" cssClass="figure-head"/>
                    <model predicate="parent::table" behaviour="block" cssClass="table-head"/>
                    <model predicate="parent::lg" behaviour="block" cssClass="lg-head"/>
                    <model predicate="parent::list" behaviour="block" cssClass="list-head"/>
                    <model predicate="parent::div" behaviour="heading">
                        <param name="level" value="count(ancestor::div)"/>
                        <!-- Outline label ("1.2.1", "iv.1.", "Appendix A.1"), as in
                             the published Guidelines. Empty outside front/body/back. -->
                        <param name="content" value="(tp:heading_mark(parent::div), node())"/>
                    </model>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="list" mode="change">
                    <model predicate="$parameters?mode='nav'" behaviour="list"/>
                    <model predicate="$parameters?mode='toc'" behaviour="omit"/>
                    <model predicate="@type=('containedBy','mayContain')" behaviour="pass-through" cssClass="module-groups">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="@type=('members','usedBy','memberOf')" behaviour="pass-through" cssClass="spec-links">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="@type='attTree'" behaviour="pass-through">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="@type='atts'" behaviour="pass-through">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="@type='catalogItems'" behaviour="pass-through">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="@type='specItems'" behaviour="pass-through">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="@type='catalog'" behaviour="pass-through">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="@type='attCatalog'" behaviour="pass-through">
                        <param name="content" value="item"/>
                        <pb:template xmlns=""><table class="spec-table"><thead><tr><th>Attribute</th><th>Defined on</th></tr></thead><tbody>[[content]]</tbody></table></pb:template>
                    </model>
                    <model predicate="@type='listRef'" behaviour="pass-through">
                        <param name="content" value="item"/>
                    </model>
                    <model predicate="parent::div[@type='guidelines-toc'] and @n and count(../list) &gt; 1" behaviour="pass-through">
                        <param name="heading" value="if (@n='front') then 'Front Matter' else if (@n='back') then 'Back Matter' else 'Text Body'"/>
                        <param name="content" value="item"/>
                        <pb:template xmlns=""><h2>[[heading]]</h2><ul class="toc">[[content]]</ul></pb:template>
                    </model>
                    <!-- A gloss list pairs label+item into dt/dd inside the listItem
                         behaviour, which reads the label straight off the source. Letting
                         the list apply its label children as well prints every term twice,
                         so the list renders everything but them. -->
                    <model predicate="label" behaviour="list" useSourceRendition="true">
                        <param name="content" value="*[not(self::label)]"/>
                    </model>
                    <model predicate="@type='toc'" behaviour="list" cssClass="toc"/>
                    <model predicate="@type='chips'" behaviour="pass-through">
                        <param name="content" value="item"/>
                    </model>
                    <model behaviour="list" useSourceRendition="true">
                        <param name="content" value="child::node()"/>
                    </model>
                </elementSpec>
                <elementSpec ident="titlePage" mode="change">
                    <desc>Home-page byline, or the full title page on Title.html.</desc>
                    <model predicate="ancestor::div[@opm:page='home']" behaviour="pass-through">
                        <!-- The docTitle as it reads on the title page: its parts run
                             together ("TEI P5: Guidelines for ..."). Dropped when it
                             only repeats the heading above it. -->
                        <param name="sub" value="if (normalize-space(docTitle) = normalize-space(ancestor::div[@opm:page='home']/head)) then () else docTitle/titlePart"/>
                        <param name="authors" value="docAuthor"/>
                        <param name="date" value="docDate"/>
                        <pb:template xmlns=""><p class="home-sub">[[sub]]</p><p class="home-byline">[[authors]] [[date]]</p></pb:template>
                    </model>
                    <model behaviour="pass-through">
                        <param name="authors" value="docAuthor"/>
                        <param name="title" value="docTitle"/>
                        <param name="byline" value="byline"/>
                        <param name="notes" value="note"/>
                        <param name="imprint" value="docImprint"/>
                        <param name="date" value="docDate"/>
                        <pb:template xmlns=""><section class="title-page">[[authors]][[title]][[byline]][[notes]][[imprint]][[date]]</section></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="docTitle" mode="change">
                    <model predicate="ancestor::titlePage" behaviour="block" cssClass="title-page__title"/>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="byline" mode="add">
                    <model behaviour="paragraph" cssClass="title-page__byline"/>
                </elementSpec>
                <elementSpec ident="docImprint" mode="change">
                    <model predicate="ancestor::titlePage" behaviour="block" cssClass="title-page__imprint"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="titlePart" mode="change">
                    <model predicate="ancestor::div[@opm:page='home']" behaviour="inline"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="docAuthor" mode="change">
                    <model predicate="ancestor::div[@opm:page='home']" behaviour="inline" cssClass="home-author"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="docDate" mode="change">
                    <model predicate="ancestor::div[@opm:page='home']" behaviour="inline" cssClass="home-date"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="p" mode="change">
                    <model predicate="$parameters?mode=('toc', 'nav')" behaviour="omit"/>
                    <model behaviour="paragraph" useSourceRendition="true"/>
                </elementSpec>
                <elementSpec ident="exemplum" mode="add">
                    <desc>Ref-page examples; typically wraps egXML or eg.</desc>
                    <model behaviour="pass-through"/>
                </elementSpec>
                <elementSpec ident="eg" mode="add">
                    <desc>Plain-text examples (as opposed to egXML) as monospace source.</desc>
                    <model behaviour="code" cssClass="eg code">
                        <param name="content" value="tp:normalize_egxml(.)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="eg:egXML" mode="add">
                    <desc>XML examples in the TEI Examples namespace
                        (http://www.tei-c.org/ns/Examples), rendered as monospace
                        source with Pygments highlighting (tp:highlight).</desc>
                    <model behaviour="code" cssClass="egXML code">
                        <param name="content" value="tp:highlight(tp:serialize_egxml(.), 'xml')"/>
                        <param name="language" value="'xml'"/>
                    </model>
                </elementSpec>
                <elementSpec ident="schemaSpec" mode="add">
                    <desc>Do not dump the schema into a chapter; point at the catalogs.</desc>
                    <model predicate="$parameters?mode='toc'" behaviour="omit"/>
                    <model behaviour="pass-through">
                        <pb:template xmlns=""><p class="lead">Full reference entries for this schema are listed under <a href="REF-ELEMENTS.html">Elements</a>, <a href="REF-CLASSES-MODEL.html">Model classes</a>, <a href="REF-CLASSES-ATTS.html">Attribute classes</a>, and <a href="REF-MACROS.html">Macros</a>.</p></pb:template>
                    </model>
                </elementSpec>

                <elementSpec ident="gi" mode="add">
                    <model predicate="tp:spec_exists(normalize-space(.), .)"
                        behaviour="link" cssClass="gi">
                        <param name="uri" value="concat('ref-', normalize-space(.), '.html')"/>
                    </model>
                    <model behaviour="inline" cssClass="gi"/>
                </elementSpec>
                <elementSpec ident="ident" mode="add">
                    <model predicate="@type = ('class', 'macro', 'datatype', 'schema') and tp:spec_exists(normalize-space(.), .)"
                        behaviour="link" cssClass="ident">
                        <param name="uri" value="concat('ref-', normalize-space(.), '.html')"/>
                    </model>
                    <model behaviour="inline" cssClass="ident"/>
                </elementSpec>
                <elementSpec ident="att" mode="add">
                    <model behaviour="inline" cssClass="att">
                        <param name="content" value="concat('@', .)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="val" mode="add">
                    <model behaviour="inline" cssClass="val"/>
                </elementSpec>
                <elementSpec ident="ptr" mode="change">
                    <desc>Resolve @target against the Guidelines tree: chapter file,
                        fragment id, and heading text for empty pointers.</desc>
                    <model predicate="@target" behaviour="link">
                        <param name="uri" value="let $id := replace(@target, '^#', ''), $hit := id($id), $chap := $hit/ancestor-or-self::div[parent::body or parent::front or parent::back][1] return if ($chap/@xml:id) then concat($chap/@xml:id, '.html', if ($chap/@xml:id = $id) then '' else concat('#', $id)) else @target"/>
                        <param name="content" value="if (normalize-space(.)) then node() else let $id := replace(@target, '^#', ''), $hit := id($id) return ($hit/head[1]/node(), $id)[1]"/>
                    </model>
                </elementSpec>
                <elementSpec ident="specDesc" mode="add">
                    <desc>Look up gloss/desc on the compiled schema
                        (``$parameters?root``) like the TEI Stylesheets' show mode.</desc>
                    <model predicate="@key" behaviour="pass-through">
                        <param name="uri" value="concat('ref-', @key, '.html')"/>
                        <param name="ident" value="@key"/>
                        <param name="rend" value="let $s := tp:spec(@key, .) return if ($s) then local-name($s) else 'elementSpec'"/>
                        <param name="gloss" value="let $s := tp:spec(@key, .), $g := normalize-space(($s/gloss[@xml:lang=$parameters?lng], $s/gloss[not(@xml:lang)], $s/gloss)[1]) return if ($g) then concat('(', $g, ') ') else ''"/>
                        <param name="desc" value="let $s := tp:spec(@key, .) return ($s/desc[@xml:lang=$parameters?lng], $s/desc[not(@xml:lang)], $s/desc)[1]"/>
                        <pb:template xmlns=""><li class="specDesc"><span class="specList-[[rend]]"><a href="[[uri]]">[[ident]]</a></span> [[gloss]][[desc]]</li></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="moduleSpec" mode="add">
                    <desc>A module declaration in running prose. Only the ident and the
                        description for the active language belong there: the FPI idno and
                        the other languages' desc are reference data, and without a model
                        every one of them lands in the text as a bare inline span.</desc>
                    <model behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="desc" value="(desc[@xml:lang=$parameters?lng], desc[not(@xml:lang)], desc)[1]"/>
                        <pb:template xmlns=""><div class="spec__chips spec__chips--inline"><span class="spec__chip">Module <strong>[[ident]]</strong><span class="spec__chip__desc">[[desc]]</span></span></div></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="specList" mode="add">
                    <model predicate="$parameters?mode='toc'" behaviour="omit"/>
                    <model behaviour="list" cssClass="specList"/>
                </elementSpec>
                <elementSpec ident="specGrp" mode="add">
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="divGen" mode="add">
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="gloss" mode="add">
                    <model behaviour="inline" cssClass="gloss"/>
                </elementSpec>
                <elementSpec ident="desc" mode="change">
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="remarks" mode="add">
                    <model behaviour="block" cssClass="remarks"/>
                </elementSpec>
                <elementSpec ident="tag" mode="add">
                    <model behaviour="inline" cssClass="tag"/>
                </elementSpec>
                <elementSpec ident="soCalled" mode="add">
                    <model behaviour="inline" cssClass="soCalled"/>
                </elementSpec>
                <elementSpec ident="mentioned" mode="add">
                    <model behaviour="inline" cssClass="mentioned"/>
                </elementSpec>
                <elementSpec ident="code" mode="change">
                    <desc>Inline technical tokens in Guidelines prose.</desc>
                    <model behaviour="inline" cssClass="code"/>
                </elementSpec>
                <elementSpec ident="term" mode="change">
                    <model behaviour="inline" cssClass="term"/>
                </elementSpec>
                <elementSpec ident="seg" mode="change">
                    <model predicate="@type='headingNumber'" behaviour="inline" cssClass="heading-number"/>
                    <model predicate="@type='module'" behaviour="inline" cssClass="muted"/>
                    <model predicate="@type=('empty','charData')" behaviour="inline" cssClass="muted"/>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="item" mode="change">
                    <model predicate="parent::list[@type='attCatalog']" behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="owners" value="gi|ident"/>
                        <pb:template xmlns=""><tr><td><code>@[[ident]]</code></td><td>[[owners]]</td></tr></pb:template>
                    </model>
                    <model predicate="parent::list[@type='catalog']" behaviour="pass-through">
                        <param name="letter" value="@n"/>
                        <param name="content" value="list"/>
                        <pb:template xmlns=""><h2 id="[[letter]]">[[letter]]</h2><ul class="catalog__list">[[content]]</ul></pb:template>
                    </model>
                    <model predicate="parent::list[@type='catalogItems']" behaviour="listItem">
                        <param name="uri" value="concat('ref-', @ident, '.html')"/>
                        <param name="label" value="if (@type='element') then concat('&lt;', @ident, '&gt;') else @ident"/>
                        <param name="module" value="@n"/>
                        <pb:template xmlns=""><a href="[[uri]]">[[label]]</a> <span class="muted">[[module]]</span></pb:template>
                    </model>
                    <model predicate="parent::list[@type='specItems']" behaviour="listItem">
                        <param name="content" value="node()"/>
                    </model>
                    <model predicate="parent::list[@type=('containedBy','mayContain')]" behaviour="pass-through">
                        <param name="module" value="@n"/>
                        <param name="content" value="list"/>
                        <pb:template xmlns=""><div class="module-group"><h4>[[module]]</h4><ul>[[content]]</ul></div></pb:template>
                    </model>
                    <model predicate="parent::list[@type=('members','usedBy','memberOf')]" behaviour="pass-through">
                        <param name="content" value="gi|ident|seg"/>
                    </model>
                    <model predicate="parent::list[@type='attTree']" behaviour="pass-through">
                        <param name="class" value="ident"/>
                        <param name="atts" value="list[@type='atts']"/>
                        <param name="nested" value="list[@type='attTree']"/>
                        <pb:template xmlns=""><div class="att-class">[[class]] [[atts]]<div class="att-class__nested">[[nested]]</div></div></pb:template>
                    </model>
                    <model predicate="parent::list[@type='atts'] and @rend='overridden'" behaviour="pass-through">
                        <param name="name" value="concat('@', @ident)"/>
                        <pb:template xmlns=""><s>[[name]]</s></pb:template>
                    </model>
                    <model predicate="parent::list[@type='atts']" behaviour="pass-through">
                        <param name="name" value="concat('@', @ident)"/>
                        <param name="uri" value="concat('ref-', parent::list/parent::item/ident, '.html#', @n)"/>
                        <pb:template xmlns=""><a href="[[uri]]">[[name]]</a></pb:template>
                    </model>
                    <!-- The label is taken as a string: letting the ref render
                         itself would nest an <a> inside the chip's own anchor,
                         which the browser then splits into two links. -->
                    <model predicate="parent::list[@type='listRef'] and ref/@type='local'" behaviour="pass-through">
                        <param name="uri" value="ref/@target"/>
                        <param name="label" value="string(ref)"/>
                        <pb:template xmlns=""><a class="spec__chip" href="[[uri]]">[[label]]</a></pb:template>
                    </model>
                    <model predicate="parent::list[@type='listRef']" behaviour="pass-through">
                        <param name="uri" value="ref/@target"/>
                        <param name="label" value="string(ref)"/>
                        <pb:template xmlns=""><a class="spec__chip" href="[[uri]]" rel="external">[[label]]</a></pb:template>
                    </model>
                    <model predicate="parent::list[@type='chips'] and @type='module'" behaviour="pass-through">
                        <param name="module" value="."/>
                        <pb:template xmlns=""><span class="spec__chip">Module <strong>[[module]]</strong></span></pb:template>
                    </model>
                    <model predicate="@type='charData'" behaviour="inline" cssClass="muted"/>
                    <model behaviour="listItem"/>
                </elementSpec>
                <elementSpec ident="elementSpec" mode="add">
                    <desc>Full reference page for an element. Nested copies in
                        Guidelines chapters are omitted (each spec is its own chunk).</desc>
                    <model predicate="not(. is $parameters?root)" behaviour="omit"/>
                    <model behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="gloss" value="(gloss[@xml:lang=$parameters?lng], gloss[not(@xml:lang)], gloss)[1]"/>
                        <param name="desc" value="(desc[not(@type='deprecationInfo')][@xml:lang=$parameters?lng], desc[not(@type='deprecationInfo')][not(@xml:lang)], desc[not(@type='deprecationInfo')])[1]"/>
                        <param name="module" value="@module"/>
                        <param name="listRef" value="tp:list_ref(.)"/>
                        <param name="attTree" value="tp:attribute_tree(.)"/>
                        <param name="localAtts" value="attList/attDef[not(@mode='delete')]"/>
                        <param name="attEmpty" value="if (attList/attDef[not(@mode='delete')] or tp:has_attribute_tree(.)) then '' else 'None beyond the global attributes.'"/>
                        <param name="memberOf" value="tp:member_of(.)"/>
                        <param name="mayContain" value="tp:may_contain(.)"/>
                        <param name="containedBy" value="tp:contained_by(.)"/>
                        <param name="models" value="tp:spec_section('ref-models', 'Processing model', model|modelGrp|modelSequence)"/>
                        <param name="notes" value="tp:spec_section('ref-notes', 'Note', (remarks[@xml:lang=$parameters?lng], remarks[not(@xml:lang)], remarks)[1])"/>
                        <param name="examples" value="let $ex := (if (exemplum[not(@xml:lang) or @xml:lang=$parameters?lng]) then exemplum[not(@xml:lang) or @xml:lang=$parameters?lng] else exemplum[1]) return tp:spec_section('ref-examples', if (count($ex) eq 1) then 'Example' else 'Examples', $ex)"/>
                        <param name="constraints" value="tp:spec_section('ref-constraints', 'Schematron', constraintSpec)"/>
                        <param name="schema" value="tp:spec_section('ref-schema', 'Content model', content)"/>
                        <pb:template xmlns=""><article class="spec spec--element"><h1><span class="spec__ident">&lt;[[ident]]&gt;</span></h1><p class="spec__gloss">[[gloss]]</p><p class="spec__lead">[[desc]]</p><div class="spec__chips"><span class="spec__chip">Module <strong>[[module]]</strong></span>[[listRef]]</div><section class="spec-section" id="ref-attributes"><h2>Attributes</h2><div class="spec-note">Global and inherited attributes:[[attTree]]</div><dl class="att-def">[[localAtts]]</dl><p class="spec-note">[[attEmpty]]</p></section><section class="spec-section" id="ref-classes"><h2>Classes and content</h2><dl class="spec-facts"><dt id="ref-memberOf">Member of</dt><dd><div class="spec-links">[[memberOf]]</div></dd><dt id="ref-mayContain">May contain</dt><dd>[[mayContain]]</dd><dt id="ref-containedBy">Contained by</dt><dd>[[containedBy]]</dd></dl></section>[[models]][[notes]][[examples]][[constraints]][[schema]]</article></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="classSpec" mode="add">
                    <model predicate="not(. is $parameters?root)" behaviour="omit"/>
                    <model predicate="@type='atts' or starts-with(@ident,'att.')" behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="gloss" value="(gloss[@xml:lang=$parameters?lng], gloss[not(@xml:lang)], gloss)[1]"/>
                        <param name="desc" value="(desc[not(@type='deprecationInfo')][@xml:lang=$parameters?lng], desc[not(@type='deprecationInfo')][not(@xml:lang)], desc[not(@type='deprecationInfo')])[1]"/>
                        <param name="module" value="@module"/>
                        <param name="attTree" value="tp:attribute_tree(.)"/>
                        <param name="localAtts" value="attList/attDef[not(@mode='delete')]"/>
                        <param name="usedBy" value="tp:used_by(.)"/>
                        <param name="members" value="tp:members(.)"/>
                        <param name="notes" value="tp:spec_section('ref-notes', 'Note', (remarks[@xml:lang=$parameters?lng], remarks[not(@xml:lang)], remarks)[1])"/>
                        <param name="examples" value="let $ex := (if (exemplum[not(@xml:lang) or @xml:lang=$parameters?lng]) then exemplum[not(@xml:lang) or @xml:lang=$parameters?lng] else exemplum[1]) return tp:spec_section('ref-examples', if (count($ex) eq 1) then 'Example' else 'Examples', $ex)"/>
                        <pb:template xmlns=""><article class="spec spec--class"><h1><span class="spec__ident">[[ident]]</span></h1><p class="spec__gloss">[[gloss]]</p><p class="spec__lead">[[desc]]</p><div class="spec__chips"><span class="spec__chip">Module <strong>[[module]]</strong></span></div><section class="spec-section" id="ref-attributes"><h2>Attributes</h2>[[attTree]]<dl class="att-def">[[localAtts]]</dl></section><section class="spec-section" id="ref-classes"><h2>Classes and content</h2><dl class="spec-facts"><dt id="ref-usedBy">Used by</dt><dd><div class="spec-links">[[usedBy]]</div></dd><dt id="ref-members">Members</dt><dd><div class="spec-links">[[members]]</div></dd></dl></section>[[notes]][[examples]]</article></pb:template>
                    </model>
                    <model behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="gloss" value="(gloss[@xml:lang=$parameters?lng], gloss[not(@xml:lang)], gloss)[1]"/>
                        <param name="desc" value="(desc[not(@type='deprecationInfo')][@xml:lang=$parameters?lng], desc[not(@type='deprecationInfo')][not(@xml:lang)], desc[not(@type='deprecationInfo')])[1]"/>
                        <param name="module" value="@module"/>
                        <param name="usedBy" value="tp:used_by(.)"/>
                        <param name="members" value="tp:members(.)"/>
                        <param name="notes" value="tp:spec_section('ref-notes', 'Note', (remarks[@xml:lang=$parameters?lng], remarks[not(@xml:lang)], remarks)[1])"/>
                        <param name="examples" value="let $ex := (if (exemplum[not(@xml:lang) or @xml:lang=$parameters?lng]) then exemplum[not(@xml:lang) or @xml:lang=$parameters?lng] else exemplum[1]) return tp:spec_section('ref-examples', if (count($ex) eq 1) then 'Example' else 'Examples', $ex)"/>
                        <pb:template xmlns=""><article class="spec spec--class"><h1><span class="spec__ident">[[ident]]</span></h1><p class="spec__gloss">[[gloss]]</p><p class="spec__lead">[[desc]]</p><div class="spec__chips"><span class="spec__chip">Module <strong>[[module]]</strong></span></div><section class="spec-section" id="ref-classes"><h2>Classes and content</h2><dl class="spec-facts"><dt id="ref-usedBy">Used by</dt><dd><div class="spec-links">[[usedBy]]</div></dd><dt id="ref-members">Members</dt><dd><div class="spec-links">[[members]]</div></dd></dl></section>[[notes]][[examples]]</article></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="macroSpec" mode="add">
                    <model predicate="not(. is $parameters?root)" behaviour="omit"/>
                    <model behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="kind" value="'macro'"/>
                        <param name="gloss" value="(gloss[@xml:lang=$parameters?lng], gloss[not(@xml:lang)], gloss)[1]"/>
                        <param name="desc" value="(desc[not(@type='deprecationInfo')][@xml:lang=$parameters?lng], desc[not(@type='deprecationInfo')][not(@xml:lang)], desc[not(@type='deprecationInfo')])[1]"/>
                        <param name="module" value="@module"/>
                        <param name="usedBy" value="tp:used_by(.)"/>
                        <param name="notes" value="tp:spec_section('ref-notes', 'Note', (remarks[@xml:lang=$parameters?lng], remarks[not(@xml:lang)], remarks)[1])"/>
                        <param name="examples" value="let $ex := (if (exemplum[not(@xml:lang) or @xml:lang=$parameters?lng]) then exemplum[not(@xml:lang) or @xml:lang=$parameters?lng] else exemplum[1]) return tp:spec_section('ref-examples', if (count($ex) eq 1) then 'Example' else 'Examples', $ex)"/>
                        <param name="schema" value="tp:spec_section('ref-schema', 'Content model', content)"/>
                        <pb:template xmlns=""><article class="spec spec--macro"><h1><span class="spec__ident">[[ident]]</span></h1><p class="spec__gloss">[[gloss]]</p><p class="spec__lead">[[desc]]</p><div class="spec__chips"><span class="spec__chip">Module <strong>[[module]]</strong></span></div><section class="spec-section" id="ref-classes"><h2>Classes and content</h2><dl class="spec-facts"><dt id="ref-usedBy">Used by</dt><dd><div class="spec-links">[[usedBy]]</div></dd></dl></section>[[notes]][[examples]][[schema]]</article></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="dataSpec" mode="add">
                    <model predicate="not(. is $parameters?root)" behaviour="omit"/>
                    <model behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="gloss" value="(gloss[@xml:lang=$parameters?lng], gloss[not(@xml:lang)], gloss)[1]"/>
                        <param name="desc" value="(desc[not(@type='deprecationInfo')][@xml:lang=$parameters?lng], desc[not(@type='deprecationInfo')][not(@xml:lang)], desc[not(@type='deprecationInfo')])[1]"/>
                        <param name="module" value="@module"/>
                        <param name="usedBy" value="tp:used_by(.)"/>
                        <param name="notes" value="tp:spec_section('ref-notes', 'Note', (remarks[@xml:lang=$parameters?lng], remarks[not(@xml:lang)], remarks)[1])"/>
                        <param name="schema" value="tp:spec_section('ref-schema', 'Content model', content)"/>
                        <pb:template xmlns=""><article class="spec spec--datatype"><h1><span class="spec__ident">[[ident]]</span></h1><p class="spec__gloss">[[gloss]]</p><p class="spec__lead">[[desc]]</p><div class="spec__chips"><span class="spec__chip">Module <strong>[[module]]</strong></span></div><section class="spec-section" id="ref-classes"><h2>Classes and content</h2><dl class="spec-facts"><dt id="ref-usedBy">Used by</dt><dd><div class="spec-links">[[usedBy]]</div></dd></dl></section>[[notes]][[schema]]</article></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="attDef" mode="add">
                    <model behaviour="pass-through">
                        <param name="ident" value="@ident"/>
                        <param name="anchor" value="concat('att-', translate(@ident, ':', '-'))"/>
                        <param name="desc" value="(desc[not(@type='deprecationInfo')][@xml:lang=$parameters?lng], desc[not(@type='deprecationInfo')][not(@xml:lang)], desc[not(@type='deprecationInfo')])[1]"/>
                        <param name="usage" value="tp:usage_label(@usage)"/>
                        <param name="datatype" value="tp:att_datatype(.)"/>
                        <param name="exemplum" value="(exemplum[@xml:lang=$parameters?lng], exemplum[not(@xml:lang)], exemplum)[1]"/>
                        <pb:template xmlns=""><dt id="[[anchor]]"><span class="att-def__name">@[[ident]]</span>[[desc]]</dt><dd><dl><dt>Status</dt><dd>[[usage]]</dd><dt>Datatype</dt><dd>[[datatype]]</dd></dl>[[exemplum]]</dd></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="model" mode="add">
                    <model behaviour="pass-through">
                        <param name="behaviour" value="@behaviour"/>
                        <param name="output" value="@output"/>
                        <param name="css" value="@cssClass"/>
                        <param name="predicate" value="@predicate"/>
                        <param name="desc" value="(desc[@xml:lang=$parameters?lng], desc[not(@xml:lang)], desc)[1]"/>
                        <param name="params" value="param"/>
                        <param name="template" value="tp:serialize_spec(*[local-name()='template'][1])"/>
                        <param name="renditions" value="outputRendition"/>
                        <param name="children" value="model|modelGrp|modelSequence"/>
                        <pb:template xmlns=""><li class="pm__item pm__model"><div class="pm__head"><code class="pm__behaviour">[[behaviour]]</code> <span class="pm__output">[[output]]</span> <code class="pm__class">[[css]]</code> <code class="pm__pred">[[predicate]]</code></div><div class="pm__desc">[[desc]]</div><dl class="pm__params">[[params]]</dl><pre class="code pm__template"><code>[[template]]</code></pre>[[renditions]]<ol class="pm">[[children]]</ol></li></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="modelGrp" mode="add">
                    <model behaviour="pass-through">
                        <param name="children" value="model|modelGrp|modelSequence"/>
                        <param name="predicate" value="@predicate"/>
                        <pb:template xmlns=""><li class="pm__item pm__modelGrp"><div class="pm__head"><span class="pm__kind">modelGrp</span> <code class="pm__pred">[[predicate]]</code></div><ol class="pm">[[children]]</ol></li></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="modelSequence" mode="add">
                    <model behaviour="pass-through">
                        <param name="children" value="model|modelGrp|modelSequence"/>
                        <param name="predicate" value="@predicate"/>
                        <pb:template xmlns=""><li class="pm__item pm__modelSequence"><div class="pm__head"><span class="pm__kind">modelSequence</span> <code class="pm__pred">[[predicate]]</code></div><ol class="pm">[[children]]</ol></li></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="param" mode="add">
                    <model predicate="parent::model or parent::modelGrp or parent::modelSequence" behaviour="pass-through">
                        <param name="name" value="@name"/>
                        <param name="value" value="@value"/>
                        <pb:template xmlns=""><dt>[[name]]</dt><dd><code>[[value]]</code></dd></pb:template>
                    </model>
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="outputRendition" mode="add">
                    <model behaviour="pass-through">
                        <param name="scope" value="(@scope, 'rendition')[1]"/>
                        <param name="css" value="string(.)"/>
                        <pb:template xmlns=""><dl class="pm__rendition"><dt>[[scope]]</dt><dd><pre class="code"><code>[[css]]</code></pre></dd></dl></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="content" mode="add">
                    <model behaviour="code" cssClass="code">
                        <param name="content" value="tp:serialize_spec(.)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="constraintSpec" mode="add">
                    <model behaviour="code" cssClass="code">
                        <param name="content" value="tp:serialize_spec(.)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="classes" mode="add">
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="attList" mode="add">
                    <model behaviour="omit"/>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>
