// TEI Publisher default Typst document shell
// Override via [transform.typst] template in project config or --template

#import "@preview/zebraw:0.6.3": *
#show: zebraw.with(..zebraw-themes.zebra, lang: true, lang-color: color.mix((blue, 15%), (white, 85%)))

#import "@preview/ilm:2.1.0": *

#set text(lang: "en")

{% set _authors = metadata.get('authors', []) -%}
#show: ilm.with(
  title: [{{ (metadata.get('title') or ['Your Title'])[0] }}],
  authors: {% if _authors | length > 1 %}({% for a in _authors %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}){% elif _authors %}"{{ _authors[0] }}"{% else %}""{% endif %},
  abstract: [{{ (metadata.get('abstract') or [''])[0] }}],
  figure-index: (enabled: true),
  table-index: (enabled: true),
  listing-index: (enabled: true)
)
#set text(font: ("New Computer Modern", "Times New Roman"))
#show raw: set text(font: ("Iosevka", "DejaVu Sans Mono", "Courier New"))

{% include "opm_css_fns_default.typ.j2" %}

#show: marginalia.setup.with(
  inner: (far: 2.5cm),
  outer: (far: opm-margin-note-far, width: opm-margin-note-width, sep: opm-margin-note-sep),
  top: 2.5cm,
  bottom: 2.5cm,
)

#let opm-css-fns = opm-css-fns + (
  guilabel: (body) => text(fill: blue)[#body],
  guibutton: (body) => box(
    stroke: 1pt,
    inset: 2pt,
    radius: 3pt,
    baseline: 2pt,
  )[ #text(size: 0.8em)[#body] ],
  code: (body) => text(font: "DejaVu Sans Mono", size: 0.8em)[#body],
  guimenuitem: (body) => box(
    fill: color.mix((blue, 15%), (white, 85%)),
    inset: (left: 0.2em, right: 0.2em, top: 0.1em, bottom: 0.1em),
    radius: 3pt,
  )[#body],
  note: (body) => box(
    inset: (left: 0.8em, top: 0.3em, bottom: 0.3em),
    stroke: (left: (paint: rgb(246, 166, 35), thickness: 3pt)),
    radius: 0pt,
  )[#body],
)

{{ odd_typst }}

#set heading(numbering: "1.")
#set par(justify: true)

{% include "opm_css.typ.j2" %}

{{ content_typst }}
