// TEI Publisher default Typst document shell
// Override via [transform.typst] template in project config or --template
#import "@preview/bookly:3.1.1": *

#show: bookly.with(
  title: "My document",
  author: "Author Name",
  theme: modern,
  lang: "en",
  tufte: false,
  fonts: (
    body: "Lato",
    math: "Lete Sans Math"
  ),
  title-page: book-title-page(
    series: "Typst book series",
    institution: "Typst community"
  ),
  config-options: (
    open-right: true,
    alt-margins: false
  )
)

{% include "opm_css_fns_default.typ.j2" %}
{% include "opm_css.typ.j2" %}

{{ odd_typst }}

#set document(
  title: "{{ parameters.get('title', '') }}",
)

{{ content_typst }}
