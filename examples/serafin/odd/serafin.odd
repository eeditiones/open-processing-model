<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:pb="http://teipublisher.com/1.0" xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Serafin Letters <desc>15th c. manuscript correspondence with parallel translation</desc></title>
            </titleStmt>
            <publicationStmt>
                <publisher>e-editiones</publisher>
                <availability>
                    <licence target="https://creativecommons.org/licenses/by/4.0/">Distributed under a
                        Creative Commons Attribution 4.0 International License</licence>
                    <p>Copyright 2017–2026 <ref target="https://e-editiones.org">e-editiones</ref> and
                        individual contributors.</p>
                    <p>Based on TEI materials © TEI Consortium (CC BY 3.0 / BSD-2-Clause).</p>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Created for Mikołaj Serafin edition with <ref target="http://tei-publisher.com">TEI Publisher</ref>
                </p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <tagsDecl>
                <pb:behaviour ident="glossary" output="latex">
                    <pb:param name="id" value="@xml:id"/>
                    <pb:param name="name"/>
                    <pb:param name="note"/>
                    <pb:template xmlns="" xml:space="preserve">\newglossaryentry{[[id]]} {
                        name=[[name]],
                        description={[[note]]}
                    }</pb:template>
                </pb:behaviour>
                <rendition source="serafin.css"/>
            </tagsDecl>
        </encodingDesc>
        <revisionDesc>
            <change when="2018-08-31+02:00">Initial version</change>
        </revisionDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec start="TEI" ident="serafin" source="teipublisher.odd">

                <!-- ==============================================================
                     1. Modules

                     `tei` is the infrastructure module (classes, macros, datatypes)
                     and is always required. The remaining seven are every module the
                     edition draws on; the include lists are exhaustive.

                     Scope: the letters, and nothing else. The registers
                     (data/registers/*.xml) are separate documents with a
                     structure of their own — standOff/listPerson, listPlace,
                     listOrg, listBibl — and they are not validated against this
                     schema, so `person`, `place`, `org`, `bibl/@type="work"`
                     and the rest of the register vocabulary are left out. The
                     letters reach the registers only by pointer (persName/@key,
                     placeName/@key), which no schema follows.

                     This is a schema decision, not a rendering one: the
                     processing models are compiled independently of these
                     include lists, so the register entries pulled into a letter
                     page by the `mode='register'` models below still render
                     through teipublisher.odd's inherited person / place specs.
                     ============================================================== -->
                <moduleRef key="tei"/>
                <moduleRef key="core"
                    include="add bibl corr date del editor emph expan gap head hi lb
                             note p publisher ref resp respStmt sic title unclear"/>
                <moduleRef key="header"
                    include="availability catRef change correspAction correspContext
                             correspDesc creation editorialDecl encodingDesc fileDesc idno
                             langUsage language licence listChange profileDesc publicationStmt
                             revisionDesc schemaRef sourceDesc teiHeader textClass
                             titleStmt"/>
                <moduleRef key="linking" include="anchor listAnnotation seg standOff"/>
                <moduleRef key="msdescription"
                    include="msContents msDesc msIdentifier physDesc repository"/>
                <!-- Only the name elements: a letter points at the registers, it
                     does not contain them. -->
                <moduleRef key="namesdates" include="orgName persName placeName"/>
                <moduleRef key="textstructure"
                    include="TEI div opener postscript signed text"/>
                <moduleRef key="transcr" include="ex subst supplied surplus"/>

                <elementSpec ident="gap" mode="change">
                    <desc>Lacunae, after the Leiden conventions. Note that 100 of the 104 gaps in
                        the edition carry no @quantity or @unit at all, so they fall to the
                        undetermined-extent rule ("[- - -]"); only four are measured.</desc>
                    <attList>
                        <attDef ident="unit" mode="change">
                            <desc>The unit @quantity counts. Only a gap measured in characters
                                can be printed as Leiden dots; one measured in words prints as
                                an undetermined lacuna, with the count kept in the XML.</desc>
                            <valList type="semi" mode="replace">
                                <valItem ident="chars">
                                    <desc>Extent in characters.</desc>
                                </valItem>
                                <valItem ident="words">
                                    <desc>Extent in words.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                    <model predicate="desc" behaviour="inline"/>

                    <!-- Leiden: a lost passage of known extent is one dot per lost
                         character, inside square brackets — [....] for four. -->
                    <model output="typst" predicate="@unit = 'chars' and @quantity and xs:integer(@quantity) le 10" behaviour="inline">
                        <param name="content" value="tp:gap_dots(@quantity)"/>
                    </model>
                    <!-- Beyond a handful of characters Leiden allows the count in place
                         of the dots, so a long lacuna does not become a rule of dots. -->
                    <model output="typst" predicate="@unit = 'chars' and @quantity" behaviour="inline">
                        <param name="content" value="'[c. ' || @quantity || ']'"/>
                    </model>
                    <!-- Dashes mark a lacuna whose extent in characters is undetermined.
                         A word count does not convert into one, so a gap measured in
                         words prints this too; the count stays in the XML and in the
                         web popover. The predicate is spelled out rather than left off:
                         a model without one is compiled as the element's default and
                         sorted last, where the inherited popover model would reach a
                         quantified gap first. -->
                    <model output="typst" predicate="not(@quantity and @unit = 'chars')" behaviour="inline">
                        <param name="content" value="'[- - -]'"/>
                    </model>

                    <model output="plain" predicate="@extent or @quantity" behaviour="inline">
                        <outputRendition xml:space="preserve" scope="before">
                        content: "[.. ..]";
                        </outputRendition>
                    </model>
                    <!-- Print has no popover runtime behind it: the <template> that
                         carries the reason/extent/unit for the web hover card would
                         otherwise print as plain text. Print gets the same precise,
                         quantity-aware dots as Typst instead rather than the web's
                         fixed "[.. ..]" glyph.

                         tp:gap_dots is an opm-only XPath extension (extensions/
                         serafin_functions.py), so the dot-generating rule is tagged
                         "opm-print" rather than "print": tei-publisher-lib (jinks)
                         does not know that function and, ported upstream, would fail
                         to compile it. tei-publisher-lib also does not recognise the
                         "opm-print" output value at all and skips models tagged with
                         it, so it falls through to the plain "print" rule below —
                         the same dot count, spelled out in portable XQuery/XPath
                         instead of calling out to Python. opm itself matches both
                         "opm-print" and "print" for -t print, and takes the first
                         match in document order, so the opm-only rule must stay
                         first. -->
                    <model output="opm-print" predicate="@unit = 'chars' and @quantity and xs:integer(@quantity) le 10" behaviour="inline">
                        <param name="content" value="tp:gap_dots(@quantity)"/>
                    </model>
                    <model output="print" predicate="@unit = 'chars' and @quantity and xs:integer(@quantity) le 10" behaviour="inline">
                        <param name="content" value="'[' || string-join(for $i in 1 to xs:integer(@quantity) return '.', '') || ']'"/>
                    </model>
                    <model output="print" predicate="@unit = 'chars' and @quantity" behaviour="inline">
                        <param name="content" value="'[c. ' || @quantity || ']'"/>
                    </model>
                    <model output="print" predicate="not(@quantity and @unit = 'chars')" behaviour="inline">
                        <param name="content" value="'[- - -]'"/>
                    </model>
                    <model output="web" predicate="@extent or @quantity" behaviour="inline">
                        <param name="extent" value="head((@extent, @quantity))"/>
                        <param name="unit" value="@unit"/>
                        <param name="reason" value="if (@reason) then @reason || ': ' else ()"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover>
                            <span class="gap" slot="default"/>
                            <template slot="alternate">[[reason]] [[ extent ]] [[unit]]</template>
                        </pb-popover></pb:template>
                        <outputRendition xml:space="preserve" scope="before">
                        content: "[.. ..]";
                        </outputRendition>
                    </model>
                    <model behaviour="inline">
                        <outputRendition xml:space="preserve" scope="before">
                        content: '[...]';
                        </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="standOff" mode="change">
                    <desc>The notes live in standOff and are pulled inline at their
                        anchors, so the section itself must not also print. Without
                        this it renders after the text as a run of unseparated note
                        texts — invisible in the chunked pages, which never contain
                        standOff, but present in every whole-document output.</desc>
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="anchor" mode="change">
                    <desc>SERAFIN: as in teipublisher.odd, except that in Typst the
                        text-critical notes (type="transcription", marked a, b, …) go to
                        the margin, leaving the footnotes to the commentary (1, 2, …).</desc>
                    <attList>
                        <attDef ident="type" mode="change">
                            <desc>Only note anchors are used: the point in the text where a
                                standOff note is pulled in. The models below branch on this,
                                so the list is closed.</desc>
                            <valList type="closed" mode="replace">
                                <valItem ident="note">
                                    <desc>Anchor for a note held in standOff/listAnnotation.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                    <model predicate="$parameters?mode=('toc', 'breadcrumb')" behaviour="omit"/>
                    <model predicate="@corresp" behaviour="note">
                        <param name="content" value="let $target := @corresp return root($parameters?root)/id($target)/node()"/>
                        <param name="label" value="@n"/>
                    </model>
                    <model output="typst" predicate="@type='note' and (let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/@type = 'transcription')" behaviour="note">
                        <param name="content" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/node()"/>
                        <param name="label" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/@n/string()"/>
                        <param name="place" value="'margin'"/>
                    </model>
                    <model predicate="@type='note'" behaviour="note">
                        <param name="content" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/node()"/>
                        <param name="label" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/@n/string()"/>
                    </model>
                    <model predicate="@xml:id" behaviour="anchor">
                        <param name="id" value="@xml:id"/>
                    </model>
                </elementSpec>
                <elementSpec ident="lb" mode="change">
                    <!-- Print does not keep the manuscript lineation, so a line
                         beginning becomes an ordinary word space. Dropping it outright
                         (as the web does, where the source whitespace survives in the
                         markup) runs words together in Typst whenever the text between
                         two elements is whitespace only — "[....]grate" for a lacuna at
                         a line end. @break="no" marks a word split across the line,
                         which must not gain a space. -->
                    <model output="typst" predicate="@break = 'no'" behaviour="omit"/>
                    <model output="typst" predicate="not(@break = 'no')" behaviour="inline">
                        <param name="content" value="' '"/>
                    </model>
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="editor" mode="add">
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="note" mode="change">
                    <attList>
                        <attDef ident="type" mode="change">
                            <desc>Suggested, not closed: the one kind a letter carries today,
                                but an editor may add categories without touching the ODD. An
                                untyped note is the commentary. ("bio", the biographical note
                                of a person register entry, is not listed: the registers are
                                not validated against this schema.)</desc>
                            <valList type="semi" mode="replace">
                                <valItem ident="transcription">
                                    <desc>Text-critical note on the transcription; lettered a, b,
                                        c … and set in the margin in Typst.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                        <attDef ident="n" mode="change">
                            <desc>Note label. Letters (a, b, c …) mark text-critical notes,
                                numbers (1, 2, 3 …) the commentary; the two series are
                                rendered to different places in print.</desc>
                        </attDef>
                    </attList>
                    <model predicate="ancestor::listAnnotation" behaviour="inline">
                        <desc>SERAFIN: notes stored in the standOff section, therefore they just
                            need to be rendered inline when pulled from corresponding anchor element
                            via the target attribute </desc>
                    </model>
                    <model predicate="$parameters?mode='register-overview' and $parameters?show-notes and text()" behaviour="block"/>
                    <model predicate="$parameters?mode='register-overview' and not($parameters?show-notes) and text()" behaviour="omit"/>
                    <model output="epub" predicate="ancestor::person or ancestor::place or ancestor::org" behaviour="block">
                        <desc>SERAFIN: as in teipublisher.odd — a register entry is a footnote
                            aside in EPUB, so a note anywhere inside it must not open a second
                            one.</desc>
                    </model>
                    <model predicate="parent::person or parent::place or parent::org" behaviour="block">
                        <desc>A note in a register entry may hold paragraphs of its own, so it
                            needs a block: a paragraph cannot nest a paragraph.</desc>
                    </model>
                    <model predicate="$parameters?mode='toc' or ancestor::listAnnotation" behaviour="omit"/>
                    <model behaviour="note">
                        <param name="place" value="@place"/>
                        <param name="label" value="@n"/>
                    </model>
                </elementSpec>
                <elementSpec ident="seg" mode="change">
                    <model output="typst" predicate="ancestor::text[@type='source']" behaviour="inline">
                        <param name="translation" value="let $id := @xml:id return root()//seg[@corresp = '#' || $id]"/>
                        <pb:template xml:space="preserve" xmlns=""><![CDATA[#opm-parallel([[[content]]], [[[translation]]]);]]></pb:template>
                    </model>
                    <model output="print" behaviour="inline"/>
                    <model output="plain" behaviour="inline"/>
                    <model output="docx" behaviour="inline"/>
                    <model output="latex" behaviour="inline">
                        <pb:template xml:space="preserve" xmlns=""><![CDATA[\pstart [[content]] \pend]]></pb:template>
                    </model>
                    <model output="epub" behaviour="inline"/>
                    <model predicate="@corresp" behaviour="webcomponent" useSourceRendition="true">
                        <desc>SERAFIN</desc>
                        <param name="name" value="'pb-highlight'"/>
                        <param name="key" value="replace(@corresp, '^#\w\.(.*)$', '$1')"/>
                        <param name="highlight-self" value="true()"/>
                        <param name="trigger" value="'click'"/>
                    </model>
                    <model behaviour="webcomponent" useSourceRendition="true">
                        <desc>SERAFIN</desc>
                        <param name="name" value="'pb-highlight'"/>
                        <param name="key" value="replace(@xml:id, '^\w\.(.*)$', '$1')"/>
                        <param name="highlight-self" value="true()"/>
                        <param name="trigger" value="'click'"/>
                    </model>
                </elementSpec>
                <elementSpec ident="TEI" mode="change">
                    <model output="fo" behaviour="document">
                        <desc>SERAFIN</desc>
                        <param name="content" value="(.//text[@type='source'], .//text[@type='translation'])"/>
                    </model>
                    <model output="print" behaviour="document">
                        <desc>SERAFIN</desc>
                        <param name="content" value="(.//titleStmt/title[not(@level)], .//fileDesc/sourceDesc/msDesc, .//profileDesc/correspDesc/correspAction[@type='sent']/date, .//text[@type='source'], .//text[@type='translation'])"/>
                    </model>
                    <modelSequence output="plain">
                        <desc>SERAFIN</desc>
                        <model behaviour="heading">
                            <param name="content" value="'Source'"/>
                            <param name="level" value="1"/>
                        </model>
                        <model behaviour="block">
                            <param name="content" value=".//text[@type='source']/node()"/>
                        </model>
                        <model behaviour="heading">
                            <param name="content" value="'Translation'"/>
                            <param name="level" value="1"/>
                        </model>
                        <model behaviour="block">
                            <param name="content" value=".//text[@type='translation']/node()"/>
                        </model>
                    </modelSequence>
                    <model predicate="$parameters?mode='letter-head'" behaviour="block">
                        <param name="content" value="(.//titleStmt/title[not(@level)], .//fileDesc/sourceDesc/msDesc, .//profileDesc/correspDesc/correspAction[@type='sent']/date)"/>
                    </model>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="pass-through">
                        <param name="content" value="teiHeader"/>
                    </model>
                    <model predicate="$parameters?mode='edition-navigation' and descendant::correspContext" behaviour="pass-through">
                        <desc>process correspContext to provide in-edition navigation buttons to
                            move between documents</desc>
                        <param name="content" value="descendant::correspContext"/>
                    </model>
                    <!-- The registers list the people and places of the letter itself.
                         correspContext only describes the neighbouring letters, so the
                         names in it are left out here and in the div models below. -->
                    <model predicate="$parameters?mode = 'register' and $parameters?category = 'people'" behaviour="pass-through">
                        <desc>Output people register only (for a dedicated tab)</desc>
                        <param name="people" value="for $key in distinct-values((root(.)//persName[not(ancestor::correspContext)]/@key, root(.)//persName[not(ancestor::correspContext)]/@ref)) return collection($global:register-root)/id($key)[self::person]"/>
                        <pb:template xml:space="preserve" xmlns=""><div class="register">
<ul>
[[people]]
</ul>
</div></pb:template>
                    </model>
                    <model predicate="$parameters?mode = 'register' and $parameters?category = 'places'" behaviour="pass-through">
                        <desc>Output places register only (for a dedicated tab)</desc>
                        <param name="places" value="for $key in distinct-values((root(.)//placeName[not(ancestor::correspContext)]/@key, root(.)//placeName[not(ancestor::correspContext)]/@ref)) return collection($global:register-root)/id($key)[self::place]"/>
                        <pb:template xml:space="preserve" xmlns=""><div class="register">
<ul>
[[places]]
</ul>
</div></pb:template>
                    </model>
                    <model predicate="$parameters?mode = 'register'" behaviour="pass-through">
                        <desc>Output register data if register profile is enabled</desc>
                        <param name="people" value="for $key in distinct-values((root(.)//persName[not(ancestor::correspContext)]/@key, root(.)//persName[not(ancestor::correspContext)]/@ref)) return collection($global:register-root)/id($key)[self::person]"/>
                        <param name="places" value="for $key in distinct-values((root(.)//placeName[not(ancestor::correspContext)]/@key, root(.)//placeName[not(ancestor::correspContext)]/@ref)) return collection($global:register-root)/id($key)[self::place]"/>
                        <pb:template xml:space="preserve" xmlns=""><div class="register">
<h3>People</h3>
<ul>
[[people]]
</ul>

<h3>Places</h3>
<ul>
[[places]]
</ul>
</div></pb:template>
                    </model>
                    <model output="docx" behaviour="document">
                        <param name="content" value="(teiHeader, .//text[@type='source'], .//text[@type='translation'])"/>
                    </model>
                    <model behaviour="document"/>
                </elementSpec>
                <elementSpec ident="div" mode="change">
                    <desc>Overrides the base (teipublisher.odd) div spec. The two category-specific
                    register models come first so they win for a given category; the remaining
                    models replicate the base div behaviour (combined register, title, section, block)
                    which would otherwise be lost when this importing ODD redefines the spec.</desc>
                    <!-- EPUB: a book, not a reading view. Nothing can stand beside
                         anything, so the transcription and the translation follow one
                         another as chapters, each headed in the edition's own words —
                         which is also what names it in the table of contents. -->
                    <modelSequence output="epub" predicate="parent::text[@type=('source', 'translation')]">
                        <model behaviour="heading">
                            <param name="level" value="1" />
                            <param name="content"
                                value="if (parent::text/@type='source') then 'Transcriptio (lat.)' else 'Przekład (pol.)'" />
                        </model>
                        <model behaviour="block" />
                    </modelSequence>
                    <!-- DOCX: the HTML template of the final pass-through model below
                         cannot be rendered into OOXML, which would drop the letter. -->
                    <model output="docx" behaviour="block"/>
                    <model predicate="$parameters?mode = 'register' and $parameters?category = 'people'" behaviour="pass-through">
                        <param name="people" value="let $refs := (root(.)//persName[@key or @ref][not(ancestor::correspContext)], root(.)//rs[@type='person'][@key or @ref][not(ancestor::correspContext)]), $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  return for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::person]"/>
                        <pb:template xml:space="preserve" xmlns=""><div class="register">
<ul>
[[people]]
</ul>
</div></pb:template>
                    </model>
                    <model predicate="$parameters?mode = 'register' and $parameters?category = 'places'" behaviour="pass-through">
                        <param name="places" value="let $refs := (root(.)//placeName[@key or @ref][not(ancestor::correspContext)], root(.)//rs[@type='place'][@key or @ref][not(ancestor::correspContext)]), $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  return for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::place]"/>
                        <pb:template xml:space="preserve" xmlns=""><div class="register">
<ul>
[[places]]
</ul>
</div></pb:template>
                    </model>
                    <model predicate="$parameters?mode = 'register'" behaviour="pass-through">
                        <param name="people" value="let $refs := (root(.)//persName[@key or @ref][not(ancestor::correspContext)], root(.)//rs[@type='person'][@key or @ref][not(ancestor::correspContext)]), $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  return for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::person]"/>
                        <param name="places" value="let $refs := (root(.)//placeName[@key or @ref][not(ancestor::correspContext)], root(.)//rs[@type='place'][@key or @ref][not(ancestor::correspContext)]), $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  return for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::place]"/>
                        <pb:template xml:space="preserve" xmlns=""><div class="register">
<h3><pb-i18n key="register-details.people">ppl</pb-i18n></h3>
<ul>
[[people]]
</ul>

<h3><pb-i18n key="register-details.places">pl</pb-i18n></h3>
<ul>
[[places]]
</ul>
</div></pb:template>
                    </model>
                    <model predicate="$parameters?mode='title'" behaviour="inline">
                        <param name="content" value="root($parameters?root)//teiHeader/fileDesc/titleStmt"/>
                    </model>
                    <model predicate="parent::body or parent::front or parent::back" behaviour="section"/>
                    <model behaviour="pass-through">
                        <param name="language" value="ancestor::text/@xml:lang"/>
                        <pb:template xml:space="preserve" xmlns=""><div lang="[[language]]" class="tei-div">[[content]]</div></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="text" mode="change">
                    <desc>The edition nests a pair of `text` elements — the Latin transcription
                        and the Polish translation — directly inside the outer `text`, and each
                        of those holds its `div` without an intervening `body`. Plain TEI does
                        not allow either: `text` requires `body` or `group`. The conformant
                        spelling of exactly this structure is
                        `text/group/text/body/div`, and migrating to it would let this content
                        model be dropped; until then the schema has to describe the files as
                        they are, or it describes nothing. No letter has a `body` — the outer
                        `text` holds the pair, the inner two hold their `div` — so `body` is
                        not in the alternation and not in the schema at all.</desc>
                    <content>
                        <alternate>
                            <elementRef key="text" minOccurs="2" maxOccurs="2"/>
                            <elementRef key="div" minOccurs="1" maxOccurs="unbounded"/>
                        </alternate>
                    </content>
                    <attList>
                        <attDef ident="type" mode="change">
                            <desc>Which half of the letter this is. The ODD's own models branch
                                on these two values, so the list is closed.</desc>
                            <valList type="closed" mode="replace">
                                <valItem ident="source">
                                    <desc>The transcription of the manuscript.</desc>
                                </valItem>
                                <valItem ident="translation">
                                    <desc>The modern Polish translation.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                    <!-- The translation is pulled into the parallel rows above, so it
                         must not also print as a second block after the source. -->
                    <model output="typst" predicate="@type = 'translation'" behaviour="omit"/>
                    <model output="print" behaviour="section"/>
                    <modelSequence output="docx">
                        <model behaviour="break">
                            <param name="type" value="'page'"/>
                        </model>
                        <model behaviour="heading">
                            <param name="content" value="if (@type='source') then 'Source (' || @xml:lang || ')' else 'Translation'"/>
                        </model>
                        <model behaviour="block"/>
                    </modelSequence>
                    <model behaviour="body"/>
                </elementSpec>
                <elementSpec ident="teiHeader" mode="change">
                    <!-- Typst: this local elementSpec replaces the inherited one, which
                         is where the title normally reaches the template's `metadata`
                         map. Pass it through so the parallel edition can head itself. -->
                    <model output="typst" behaviour="pass-through">
                        <param name="content" value="fileDesc/titleStmt/title[1]"/>
                    </model>
                    <model output="epub" behaviour="pass-through">
                        <param name="content" value="fileDesc/titleStmt"/>
                    </model>
                    <model output="latex" behaviour="metadata"/>
                    <model output="fo" behaviour="omit"/>
                    <model output="docx" behaviour="pass-through">
                        <param name="content" value="fileDesc/titleStmt"/>
                    </model>
                    <model predicate="$parameters?mode=('breadcrumb', 'title')" behaviour="inline">
                        <param name="content" value="fileDesc/titleStmt"/>
                    </model>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="pass-through"/>
                    <model predicate="$parameters?display='browse'" behaviour="block"/>
                    <model behaviour="metadata"/>
                </elementSpec>
                <elementSpec ident="titleStmt" mode="change">
                    <model output="latex" behaviour="metadata"/>
                    <model output="fo" behaviour="heading"/>
                    <modelSequence output="docx">
                        <model behaviour="heading">
                            <param name="content" value="title[not(@level)]"/>
                            <param name="level" value="1"/>
                        </model>
                        <model behaviour="heading">
                            <param name="content" value="title[@level]"/>
                            <param name="level" value="2"/>
                        </model>
                        <model behaviour="paragraph">
                            <param name="content" value="string-join(editor, ', ')"/>
                        </model>
                    </modelSequence>
                    <modelSequence output="epub">
                        <model behaviour="block">
                            <param name="content" value="title"/>
                        </model>
                        <model behaviour="paragraph">
                            <param name="content" value="editor"/>
                        </model>
                    </modelSequence>
                    <model predicate="$parameters?mode=('breadcrumb', 'title')" behaviour="inline">
                        <desc>for breadcrumbs, pick only the first title</desc>
                        <param name="content" value="title[1]"/>
                    </model>
                    <model predicate="$parameters?mode='register-details'" behaviour="listItem">
                        <desc>List of letters in register detail view</desc>
                        <param name="content" value="head((title[@type='main'], title))"/>
                    </model>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="block"/>
                    <modelSequence output="web" predicate="$parameters?display='browse'">
                        <desc>Display short metadata in document lists in the browse view</desc>
                        <model predicate="$parameters?static" behaviour="link">
                            <param name="content" value="title[1]"/>
                            <param name="uri" value="$parameters?context-path || '/' || util:document-name(.) || '/1/index.html'"/>
                        </model>
                        <model predicate="not($parameters?static)" behaviour="link">
                            <param name="content" value="title[1]"/>
                            <param name="uri" value="$parameters?doc"/>
                        </model>
                        <model behaviour="block">
                            <param name="content" value="author"/>
                        </model>
                    </modelSequence>
                    <model output="web" behaviour="block"/>
                </elementSpec>
                <elementSpec ident="msIdentifier" mode="change">
                    <desc>Repository and shelfmark, the only two the edition records. Dropping
                        TEI's place hierarchy (country, region, settlement, institution) and
                        the altIdentifier branch keeps collection, institution, msName and
                        altIdentifier out of the schema.</desc>
                    <content>
                        <sequence>
                            <elementRef key="repository"/>
                            <elementRef key="idno"/>
                        </sequence>
                    </content>
                </elementSpec>
                <elementSpec ident="physDesc" mode="change">
                    <desc>A sentence of prose on dimensions and condition ("209 × 260 mm; ślady
                        zawilgocenia…"). TEI's model.physDescPart — handDesc, bindingDesc,
                        decoDesc and the rest — is dropped; no letter carries one.</desc>
                    <content>
                        <classRef key="model.pLike" minOccurs="1" maxOccurs="unbounded"/>
                    </content>
                </elementSpec>
                <elementSpec ident="msContents" mode="change">
                    <desc>Every letter describes its manuscript in a sentence of prose
                        ("recto: tekst listu, podpis, dopisek; verso: adres, ślady po
                        pieczęci"), which is TEI's `model.pLike` branch. The other branch —
                        summary, textLang, titlePage, msItem — is dropped: nothing in the
                        edition uses it, and keeping it pulled 23 elements into the schema,
                        the whole msItem/biblStruct chain among them, that no letter can
                        contain. Restore the stock content model before encoding a
                        structured manuscript description.</desc>
                    <content>
                        <classRef key="model.pLike" minOccurs="1" maxOccurs="unbounded"/>
                    </content>
                </elementSpec>
                <elementSpec ident="msDesc" mode="change">
                    <desc>All 46 letters describe the manuscript the same way: where it is,
                        what is on it, what it looks like. TEI's history, additional, msPart
                        and msFrag branches are dropped — see msContents for the reasoning
                        and the cost of keeping them.</desc>
                    <content>
                        <sequence>
                            <elementRef key="msIdentifier"/>
                            <elementRef key="msContents"/>
                            <elementRef key="physDesc"/>
                        </sequence>
                    </content>
                    <attList>
                        <attDef ident="type" mode="change">
                            <desc>Every letter in the edition survives as a fair copy; kept open
                                for drafts and registers of outgoing letters.</desc>
                            <valList type="semi" mode="replace">
                                <valItem ident="fair-copy">
                                    <desc>A fair copy of the letter as sent.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="listItem"/>
                    <model behaviour="paragraph">
                        <param name="content" value="('Or.:', msIdentifier, physDesc/p/node(), msContents/p/node())"/>
                    </model>
                </elementSpec>
                <elementSpec ident="date" mode="change">
                    <model output="print" predicate="ancestor::teiHeader" behaviour="paragraph">
                        <desc>Letter-head date only (teiHeader/profileDesc/correspDesc). This model
                            had no predicate at all, so it also caught every date embedded inline in
                            running prose ("ad feriam secundam proximam post Conductum Pasche" etc.) —
                            each one broke its sentence into its own right-aligned paragraph, since a
                            block-level p cannot sit inside the inline span the sentence is wrapped in
                            and paged-media renderers force a break there instead.</desc>
                        <outputRendition xml:space="preserve">
                        text-align: right;
                        </outputRendition>
                    </model>
                    <model predicate="$parameters?display='browse' or $parameters?mode=('breadcrumb', 'title')" behaviour="inline"/>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="title" mode="change">
                    <model output="typst" predicate="ancestor::teiHeader" behaviour="metadata">
                        <param name="key" value="'title'"/>
                    </model>
                    <model output="print" predicate="parent::titleStmt and not(@level)" behaviour="heading">
                        <desc>Document title page only — this model had no predicate at all, so it
                            was winning first-match-wins for *every* title element compiled for
                            print, including bibliographic citations inside footnotes. Those rarely
                            contain a comma at the right spot, so substring-before(., ',') returned
                            "" and the citation silently became an empty h1 sitting in the
                            middle of the footnote text.</desc>
                        <param name="content" value="substring-before(., ',')"/>
                        <param name="level" value="1"/>
                    </model>
                    <model predicate="$parameters?mode='letter-head'" behaviour="heading">
                        <param name="content" value="substring-before(., ',')"/>
                        <param name="level" value="1"/>
                    </model>
                    <model predicate="$parameters?mode=('breadcrumb', 'title')" behaviour="inline"/>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="block"/>
                    <model predicate="$parameters?mode='register-details' and $parameters?static" behaviour="link">
                        <param name="uri" value="$parameters?context-path || '/letters/' || util:document-name(.) || '/1/index.html'"/>
                        <param name="content" value="string()"/>
                    </model>
                    <model predicate="$parameters?mode='register-details'" behaviour="link">
                        <desc>create a link to the document, respecting address-by-id configuration</desc>
                        <param name="content" value="string()"/>
                        <param name="uri" value="                         if ($global:address-by-id) then                             '../' || root(.)/descendant-or-self::TEI/@xml:id                                                      else                                 '../' || substring-after(document-uri(root(.)), $global:data-root || '/')                          "/>
                    </model>
                    <model predicate="$parameters?display='browse'" behaviour="heading">
                        <param name="level" value="5"/>
                    </model>
                    <model predicate="@key or @ref" behaviour="alternate">
                        <param name="alternate" value="let $key:= head((@key, @ref))  return collection($global:register-root)/id($key)"/>
                        <param name="default" value="."/>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="correspContext" mode="change">
                    <desc>Emit machine-readable stems for the letter toolbar (letter.html.j2,
                        Astro FolioNav). Overwrites the base teipublisher.odd correspContext
                        models (pb-popover icon toolbar).</desc>
                    <model predicate="$parameters?mode='edition-navigation'" behaviour="pass-through">
                        <param name="previous" value="let $t := (ref[@type = ('previous', 'prev')]/@target)[1] return if ($t) then replace($t, '\.xml$', '') else ()"/>
                        <param name="next" value="let $t := (ref[@type = 'next']/@target)[1] return if ($t) then replace($t, '\.xml$', '') else ()"/>
                        <param name="previous-in-correspondence" value="let $t := (ref[@type = 'previous-in-correspondence']/@target)[1] return if ($t) then replace($t, '\.xml$', '') else ()"/>
                        <param name="next-in-correspondence" value="let $t := (ref[@type = 'next-in-correspondence']/@target)[1] return if ($t) then replace($t, '\.xml$', '') else ()"/>
                        <pb:template xmlns="" xml:space="preserve"><nav class="corresp-nav" hidden="hidden" data-previous="[[previous]]" data-next="[[next]]" data-previous-in-correspondence="[[previous-in-correspondence]]" data-next-in-correspondence="[[next-in-correspondence]]"></nav></pb:template>
                    </model>
                    <model behaviour="omit">
                        <desc>Correspondence nav is only produced via mode=edition-navigation.</desc>
                    </model>
                </elementSpec>
                <elementSpec ident="publicationStmt" mode="change">
                    <model predicate="$parameters?display='browse'" behaviour="omit"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="signed" mode="change">
                    <model behaviour="block" cssClass="signed"/>
                </elementSpec>

                <!-- ==============================================================
                     Attribute vocabularies carrying no processing model of their
                     own. Closed where this ODD's models branch on the value, so a
                     typo would silently change the output; suggested ("semi")
                     where the vocabulary is descriptive and editors may extend it.
                     ============================================================== -->
                <elementSpec ident="correspAction" mode="change">
                    <attList>
                        <attDef ident="type" mode="change">
                            <desc>The letter-head models select the "sent" action for its date
                                and place, so the list is closed.</desc>
                            <valList type="closed" mode="replace">
                                <valItem ident="sent">
                                    <desc>Sender, place and date of sending.</desc>
                                </valItem>
                                <valItem ident="received">
                                    <desc>Addressee.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
                <elementSpec ident="ref" mode="change">
                    <attList>
                        <attDef ident="type" mode="change">
                            <desc>Navigation between letters, read by the correspContext model
                                above to build the toolbar. "prev" is accepted alongside
                                "previous" because the model matches both.</desc>
                            <valList type="closed" mode="replace">
                                <valItem ident="previous">
                                    <desc>Preceding letter in the edition.</desc>
                                </valItem>
                                <valItem ident="prev">
                                    <desc>Deprecated spelling of "previous".</desc>
                                </valItem>
                                <valItem ident="next">
                                    <desc>Following letter in the edition.</desc>
                                </valItem>
                                <valItem ident="previous-in-correspondence">
                                    <desc>Preceding letter between the same two people.</desc>
                                </valItem>
                                <valItem ident="next-in-correspondence">
                                    <desc>Following letter between the same two people.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
                <!-- persName and placeName carry no elementSpec here. In a letter
                     they are a pointer into a register and nothing else: @key or
                     @ref, no @type. The main / variant / sort vocabulary belongs
                     to the register entries, which this schema does not cover. -->
                <elementSpec ident="bibl" mode="change">
                    <attList>
                        <attDef ident="type" mode="change">
                            <desc>A letter cites its previous printing, in sourceDesc. The
                                other value in the edition, "work", labels an entry in the
                                register of works and is out of scope here.</desc>
                            <valList type="semi" mode="replace">
                                <valItem ident="printed-edition">
                                    <desc>The printed edition a letter was previously published in.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
                <elementSpec ident="hi" mode="change">
                    <attList>
                        <attDef ident="rend" mode="change">
                            <desc>Rendition of the manuscript's own highlighting. Note that one
                                instance in the edition carries this value on @ana instead,
                                which is a pointer attribute and cannot hold it.</desc>
                            <valList type="semi" mode="replace">
                                <valItem ident="i">
                                    <desc>Set in italics.</desc>
                                </valItem>
                                <valItem ident="space">
                                    <desc>Set with additional letter spacing.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
                <elementSpec ident="add" mode="change">
                    <attList>
                        <attDef ident="status" mode="change">
                            <valList type="semi" mode="replace">
                                <valItem ident="unremarkable">
                                    <desc>An addition calling for no comment.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
                <elementSpec ident="del" mode="change">
                    <attList>
                        <attDef ident="type" mode="change">
                            <valList type="semi" mode="replace">
                                <valItem ident="overwritten">
                                    <desc>Deleted by writing over the original text.</desc>
                                </valItem>
                            </valList>
                        </attDef>
                    </attList>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>