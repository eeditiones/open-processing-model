  The Serafin page shell shared by the letter pages and the letter list: the
  edition's fonts, the menubar and the parchment breadcrumb band, on top of
  opm's packaged layout. letter.css (from [transform.web] assets) supplies the
  theme. Templates extending this one fill `breadcrumb`, `menubar_extra` and
  the layout's content and sidebar blocks.
-#}
---toml
styles = [
  "https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,300..700;1,300..700&family=Belleza&display=swap",
]

[body]
classes = ["letter"]
---
{% extends "opm/layout.html.j2" %}

{% block meta %}{{ super() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% endblock %}

{% block header %}
  {# The collection index at the output root: one level up from a letter. #}
  {% set home_href = index_url if index_url is defined and index_url else 'index.html' %}
  <nav class="app-menubar" aria-label="Edition">
    <a class="app-logo" href="{{ home_href }}">{% include "logo-textmark.svg" %}</a>
    {% block menubar_extra %}{% endblock %}
  </nav>
  <div class="app-toolbar">
    <nav class="app-breadcrumb" aria-label="breadcrumb">{% block breadcrumb %}{% endblock %}</nav>
  </div>
{% endblock %}
