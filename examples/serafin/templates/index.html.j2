<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <!-- index template: letter list, same shell as letter.html.j2 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,300..700;1,300..700&family=Belleza&display=swap"
    rel="stylesheet"
  >
  <style type="text/css">
    {% include "chapbook.css" %}
  </style>
  <style type="text/css">
    {% include "parchment.css" %}
  </style>
  <style type="text/css">
    {% include "letter.css" %}
  </style>
  {% if odd_css %}
  <style type="text/css">
{{ odd_css }}
  </style>
  {% endif %}
  {% if user_css %}
  <style type="text/css">
{{ user_css }}
  </style>
  {% endif %}
  <style type="text/css">
    /* Index-only: the letter list. Everything else is inherited from the
       edition's own stylesheets so this page cannot drift from the letters. */
    .letter-list { list-style: none; margin: 0; padding: 0; }
    .letter-list__item {
      padding: 1.1rem 0;
      border-bottom: 1px solid var(--chap-rule, rgba(90, 74, 58, .22));
    }
    .letter-list__item:last-child { border-bottom: 0; }
    /* The ODD's browse models emit the heading and its link; style them in
       place rather than wrapping them in anything of our own. */
    .letter-list__entry .tei-title { font-family: var(--chap-display, "Belleza", serif); }
    .letter-list__entry h5 { margin: 0; font-size: 1.05rem; font-weight: 500; }
    .letter-list__entry a { color: inherit; text-decoration: none; }
    .letter-list__entry a:hover .tei-title { text-decoration: underline; }
    .letter-list__entry .tei-placeName,
    .letter-list__entry .tei-date { opacity: .75; }
    /* Empty wrappers appear where a letter has no author or description. */
    .letter-list__entry div:empty { display: none; }
    .letter-list__meta { font-size: .8rem; opacity: .5; margin-top: .2rem; }
  </style>
</head>
<body class="chapbook letter">
  <nav class="app-menubar" aria-label="Edition">
    <a class="app-logo" href="index.html">{% include "logo-textmark.svg" %}</a>
    <span class="app-menubar__folio">{{ documents | length }} letters</span>
  </nav>

  <div class="app-toolbar">
    <nav class="app-breadcrumb" aria-label="breadcrumb">{{ title }}</nav>
  </div>

  <main class="chap-page">
    <div class="chap-body">
      <article class="content">
        <ul class="letter-list">
          {% for doc in documents %}
          <li class="letter-list__item">
            <div class="letter-list__entry">
              {% if doc.fragments.browse %}
              {{ doc.fragments.browse | safe }}
              {% else %}
              <h5><a href="{{ doc.href }}">{{ doc.fragments.title | safe if doc.fragments.title else doc.label }}</a></h5>
              {% endif %}
              <div class="letter-list__meta">
                <a href="{{ doc.href }}">{{ doc.name }}</a>
              </div>
            </div>
          </li>
          {% endfor %}
        </ul>
      </article>
    </div>
  </main>
</body>
</html>
