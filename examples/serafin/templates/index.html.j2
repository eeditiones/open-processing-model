<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <!-- index template: letter list, same shell as letter.html.j2 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,300..700;1,300..700&family=Belleza&display=swap"
    rel="stylesheet"
  >
  {# Stylesheets copied in via chunking.assets, in declared order; letter.css
     finds parchment.jpg beside it because both land in assets/. #}
  {% for href in asset_styles %}
  <link rel="stylesheet" href="{{ href }}">
  {% endfor %}
  {% if odd_css_url %}
  <link rel="stylesheet" href="{{ odd_css_url }}">
  {% elif odd_css %}
  <style type="text/css">
{{ odd_css }}
  </style>
  {% endif %}
</head>
<body class="letter">
  <nav class="app-menubar" aria-label="Edition">
    <a class="app-logo" href="index.html">{% include "logo-textmark.svg" %}</a>
    <span class="app-menubar__folio">{{ documents | length }} letters</span>
  </nav>

  <div class="app-toolbar">
    <nav class="app-breadcrumb" aria-label="breadcrumb">{{ title }}</nav>
  </div>

  <main class="letter-page">
    <div class="letter-body">
      <article class="content">
        <ul class="letter-list">
          {% for doc in documents %}
          <li class="letter-list__item">
            <div class="letter-list__entry">
              {% if doc.fragments.browse %}
              {{ doc.fragments.browse | safe }}
              {% else %}
              <h5><a href="{{ doc.href }}">{{ doc.fragments.title | safe if doc.fragments.title else doc.label }}</a></h5>
              {% endif %}
              <div class="letter-list__meta">
                <a href="{{ doc.href }}">{{ doc.name }}</a>
              </div>
            </div>
          </li>
          {% endfor %}
        </ul>
      </article>
    </div>
  </main>
</body>
</html>
