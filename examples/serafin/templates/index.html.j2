  The letter list `opm chunk data/letters` writes at the output root, in the
  same shell as the letters (serafin.html.j2).
-#}
{% extends "serafin.html.j2" %}

{% block title %}<title>{{ title }}</title>{% endblock %}

{% block menubar_extra %}
  <span class="app-menubar__folio">{{ documents | length }} letters</span>
{% endblock %}

{% block breadcrumb %}{{ title }}{% endblock %}

{% block content %}
  <div class="letter-body">
    <article class="content">
      <ul class="letter-list">
        {% for doc in documents %}
        <li class="letter-list__item">
          <div class="letter-list__entry">
            {% if doc.fragments.browse %}
            {{ doc.fragments.browse | safe }}
            {% else %}
            <h5><a href="{{ doc.href }}">{{ doc.fragments.title | safe if doc.fragments.title else doc.label }}</a></h5>
            {% endif %}
            <div class="letter-list__meta">
              <a href="{{ doc.href }}">{{ doc.name }}</a>
            </div>
          </div>
        </li>
        {% endfor %}
      </ul>
    </article>
  </div>
{% endblock %}
