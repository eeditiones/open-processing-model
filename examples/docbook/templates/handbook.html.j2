<!doctype html>
<html lang="{{ lang|default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
{% set work_title = fragments.title | striptags | trim if fragments is defined and fragments.title else '' %}
  <title>{{ work_title or 'Handbook' }}</title>
  <!-- handbook template: documentation-oriented reading (Starlight-inspired) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Sora:wght@500;600;700&display=swap"
    rel="stylesheet"
  >
  {{ head_html | safe }}
  <style type="text/css">
    {% include "handbook.css" %}
  </style>
  {% if odd_css %}
  <style type="text/css">
{{ odd_css }}
  </style>
  {% endif %}
  {% if context.webcomponents_url %}
  <script type="module" src="{{ context.webcomponents_url }}"></script>
  {% endif %}
</head>
{% set is_chunk = chunk is defined and chunk %}
{% set has_toc = fragments is defined and fragments.toc %}
<body class="handbook{% if has_toc %} handbook--with-toc{% endif %}">
  <a class="hb-skip" href="#hb-content">Skip to content</a>

  <header class="hb-header">
    <div class="hb-header__inner">
      {% if has_toc %}
      <input type="checkbox" id="hb-nav-toggle" class="hb-nav__toggle" autocomplete="off">
      <label for="hb-nav-toggle" class="hb-nav__open" aria-label="Open menu">
        <span class="hb-nav__burger" aria-hidden="true"></span>
      </label>
      {% endif %}
      <span class="hb-brand">{{ work_title or 'Handbook' }}</span>
      {% if index_url %}
      <nav class="hb-menu" aria-label="Site">
        <a class="hb-menu__home" href="{{ index_url }}">Home</a>
      </nav>
      {% endif %}
    </div>
  </header>

  <div class="hb-shell">
    {% if has_toc %}
    <aside class="hb-sidebar" aria-label="Site navigation">
      <label for="hb-nav-toggle" class="hb-nav__backdrop" aria-hidden="true"></label>
      <div class="hb-sidebar__panel">
        <header class="hb-sidebar__head">
          <span class="hb-sidebar__title">Contents</span>
          <label for="hb-nav-toggle" class="hb-nav__close">Close</label>
        </header>
        <nav class="hb-sidebar__body">
          {{ fragments.toc | safe }}
        </nav>
      </div>
    </aside>
    {% endif %}

    <div class="hb-main">
      <main class="hb-page{% if is_chunk %} hb-page--chunk{% endif %}" id="hb-content">
        {% if is_chunk and fragments is defined and fragments.breadcrumbs %}
        <nav class="hb-crumbs" aria-label="Breadcrumb">
          {{ fragments.breadcrumbs | safe }}
        </nav>
        {% endif %}

        <article class="content">
          {{ content_html | safe }}
        </article>

        {% if is_chunk and (chunk.prev or chunk.next) %}
        <nav class="hb-pager" aria-label="Page navigation">
          <div class="hb-pager__prev">
            {% if chunk.prev %}
            <a href="{{ chunk.prev }}.html">
              <span class="hb-pager__dir">Previous</span>
              <span class="hb-pager__label">Previous page</span>
            </a>
            {% endif %}
          </div>
          <div class="hb-pager__next">
            {% if chunk.next %}
            <a href="{{ chunk.next }}.html">
              <span class="hb-pager__dir">Next</span>
              <span class="hb-pager__label">Next page</span>
            </a>
            {% endif %}
          </div>
        </nav>
        {% endif %}
      </main>

      <aside class="hb-outline" aria-label="On this page" hidden>
        <p class="hb-outline__title">On this page</p>
        <nav class="hb-outline__nav"></nav>
      </aside>
    </div>
  </div>

  <script>
  (function () {
    var article = document.querySelector('.hb-page .content');
    var outline = document.querySelector('.hb-outline');
    var nav = document.querySelector('.hb-outline__nav');
    if (!article || !outline || !nav) return;

    var heads = article.querySelectorAll('h2[id], h3[id]');
    if (!heads.length) {
      heads = article.querySelectorAll('h2, h3');
      Array.prototype.forEach.call(heads, function (h, i) {
        if (!h.id) {
          var base = (h.textContent || 'section').trim()
            .toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').slice(0, 48);
          h.id = base ? base + (i ? '-' + i : '') : 'section-' + i;
        }
      });
    }
    if (!heads.length) return;

    var ul = document.createElement('ul');
    Array.prototype.forEach.call(heads, function (h) {
      var li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'hb-outline__h3' : 'hb-outline__h2';
      var a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = (h.textContent || '').trim();
      li.appendChild(a);
      ul.appendChild(li);
    });
    nav.appendChild(ul);
    outline.hidden = false;
  })();
  </script>
</body>
</html>
