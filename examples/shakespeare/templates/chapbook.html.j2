{#
  SPDX-FileCopyrightText: 2026 e-editiones
  SPDX-License-Identifier: CC0-1.0

  chapbook: multi-page, text-centric reading, on opm's packaged page layout
  (opm/layout.html.j2). The layout writes the menubar and the breadcrumb
  toolbar; chapbook adds its text-size buttons to the menubar, the contents
  as the `before` column and page-turn links around the text. chapbook.css
  styles it all.

  Its stylesheet, chapbook.css, is listed under [transform.web] assets in
  opm.toml: copied next to the output and linked by the base template.

  Shakespeare adds a facsimile column to the scaffold shell: a IIIF viewer
  (<pb-tify>) beside the transcription, turned by the <pb-facs-link> each
  folio emits. context.scripts carries pb-tify.js, which ships as its own
  entry point rather than inside the pb-components bundle.
-#}
---toml
styles = [
  "https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..600&family=Hanken+Grotesk:wght@400;500;600&display=swap",
]

[body]
classes = ["chapbook"]
---
{% extends "opm/layout.html.j2" %}
{% set work_title = (fragments.title | striptags | trim if fragments is defined and fragments.title else '') or 'Chapbook' %}
{% set is_chunk = chunk is defined and chunk %}
{% set has_toc = fragments is defined and fragments.toc %}
{% set show_facsimile = is_chunk and context.webcomponents_url %}
{% block meta %}{{ super() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% endblock %}

{% block title %}<title>{{ work_title }}</title>{% endblock %}

{% block body_class %}{% if has_toc %}chapbook--with-toc{% endif %}{% if show_facsimile %} chapbook--with-facs{% endif %}{% endblock %}

{# pb-components resolve relative URLs against the endpoint of an ancestor
   <pb-page>; without one getEndpoint() is undefined and pb-tify asks for
   /undefined/assets/…. "." makes the manifest resolve beside the page.
   api-version is pinned so pb-page does not probe ./api/version. #}
{% block body %}
  {% if show_facsimile %}
  <pb-page endpoint="." api-version="1.0.0" theme="{{ context.webcomponents_theme }}">
  {{ super() }}
  </pb-page>
  {% else %}
  {{ super() }}
  {% endif %}
{% endblock %}

{# Reader-set text size, remembered per browser. #}
{% block menu_toggles %}
  <li class="chap-zoom">
    <button type="button" data-chap-zoom="-0.1" title="Smaller text" aria-label="Smaller text">A&minus;</button>
    <button type="button" data-chap-zoom="0.1" title="Larger text" aria-label="Larger text">A+</button>
  </li>
{% endblock %}

{% block before %}
  {% if has_toc %}
  <nav class="chap-toc" aria-label="Contents">
    <p class="chap-toc__title">Contents</p>
    {{ fragments.toc | safe }}
  </nav>
  {% endif %}
{% endblock %}

{% block content %}
  <div class="chap-page{% if is_chunk %} chap-page--chunk{% endif %}{% if has_toc %} chap-page--with-toc{% endif %}{% if show_facsimile %} chap-page--with-facs{% endif %}">
    <div class="chap-body">
      <article class="content" id="chap-content">
        {{ content_html | safe }}
      </article>
    </div>

    {% if is_chunk and (chunk.prev or chunk.next) %}
    <nav class="chap-folio-nav__foot" aria-label="Page navigation">
      <div>
        {% if chunk.prev %}<a href="{{ chunk.prev }}.html" rel="prev">&#8592; Previous</a>{% endif %}
      </div>
      <div>
        {% if chunk.next %}<a href="{{ chunk.next }}.html" rel="next">Next &#8594;</a>{% endif %}
      </div>
    </nav>
    {% endif %}
  </div>
{% endblock %}

{% block after %}
  {% if show_facsimile %}
  <!-- pb-facs-link emits the manifest URL and page index on the
        "transcription" channel; pb-tify subscribes and turns to that page. -->
  <aside class="chap-facs" aria-label="Facsimile">
    <pb-tify subscribe="transcription" emit="transcription"></pb-tify>
  </aside>
  {% endif %}
{% endblock %}

{% block footer %}
  {% if context.footer %}
  <div class="chap-footer">
    <div class="chap-footer__inner">{{ context.footer | safe }}</div>
  </div>
  {% endif %}
{% endblock %}

{% block body_end %}
  {% if is_chunk and chunk.prev %}
  <div class="chap-folio-nav__rail chap-folio-nav__rail--prev">
    <a href="{{ chunk.prev }}.html" rel="prev" title="Previous page (left arrow key)">
      <span class="chap-folio-nav__chevron" aria-hidden="true">&#8592;</span>
      <span class="chap-folio-nav__dir">Previous</span>
    </a>
  </div>
  {% endif %}
  {% if is_chunk and chunk.next %}
  <div class="chap-folio-nav__rail chap-folio-nav__rail--next">
    <a href="{{ chunk.next }}.html" rel="next" title="Next page (right arrow key)">
      <span class="chap-folio-nav__chevron" aria-hidden="true">&#8594;</span>
      <span class="chap-folio-nav__dir">Next</span>
    </a>
  </div>
  {% endif %}

  <script>
  (function () {
    var content = document.getElementById('chap-content');
    if (content) {
      var KEY = 'opm-chapbook-font-size';
      try {
        var saved = localStorage.getItem(KEY);
        if (saved) content.style.fontSize = saved + 'rem';
      } catch (e) { /* private mode: text stays at its default size */ }

      document.querySelectorAll('[data-chap-zoom]').forEach(function (button) {
        button.addEventListener('click', function () {
          var step = parseFloat(button.getAttribute('data-chap-zoom'));
          var current = parseFloat(getComputedStyle(content).fontSize) / 16;
          var next = Math.max(0.8, Math.min(2, current + step)).toFixed(2);
          content.style.fontSize = next + 'rem';
          try { localStorage.setItem(KEY, next); } catch (e) { /* not remembered */ }
        });
      });
    }

    {# Arrow keys turn the page, as the rails do. #}
    var prev = document.querySelector('.chap-folio-nav__rail--prev a');
    var next = document.querySelector('.chap-folio-nav__rail--next a');
    if (!prev && !next) return;
    document.addEventListener('keydown', function (event) {
      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
      var active = document.activeElement;
      if (active && (active.isContentEditable || /^(INPUT|TEXTAREA|SELECT|BUTTON)$/.test(active.tagName))) return;
      if (event.key === 'ArrowLeft' && prev) window.location.assign(prev.getAttribute('href'));
      else if (event.key === 'ArrowRight' && next) window.location.assign(next.getAttribute('href'));
    });
  })();
  </script>
{% endblock %}
