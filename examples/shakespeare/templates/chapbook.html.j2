<!doctype html>
{% set is_chunk = chunk is defined and chunk %}
{% set show_facsimile = is_chunk and context.webcomponents_url and context.facsimile_viewer %}
<html lang="{{ lang|default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
{% set work_title = fragments.title | striptags | trim if fragments is defined and fragments.title else '' %}
  <title>{{ work_title or 'Chapbook' }}</title>
  <!-- chapbook template: multi-page, text-centric reading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&display=swap"
    rel="stylesheet"
  >
  {{ head_html | safe }}
  <style type="text/css">
    {% include "chapbook.css" %}
  </style>
  {% if odd_css %}
  <style type="text/css">
{{ odd_css }}
  </style>
  {% endif %}
  {% if context.webcomponents_url %}
  <script type="module" src="{{ context.webcomponents_url }}"></script>
  {% endif %}
  {% if show_facsimile %}
  <!-- pb-tify ships as its own entry point; the bundle above does not carry it -->
  <script type="module" src="{{ context.facsimile_viewer }}"></script>
  {% endif %}
</head>
<body class="chapbook">
  {% if show_facsimile %}
  <!-- pb-components resolve relative URLs against the endpoint of an ancestor
       <pb-page>; without one getEndpoint() is undefined and pb-tify asks for
       /undefined/assets/…. "." makes the manifest resolve beside the page.
       api-version is pinned so pb-page does not probe ./api/version. -->
  <pb-page endpoint="." api-version="1.0.0" theme="{{ context.webcomponents_theme }}">
  {% endif %}
  <header class="chap-running">
    <span class="chap-running__work">{{ work_title or 'Chapbook' }}</span>
  </header>

  <main class="chap-page{% if is_chunk %} chap-page--chunk{% endif %}{% if fragments is defined and fragments.toc %} chap-page--with-toc{% endif %}{% if show_facsimile %} chap-page--with-facs{% endif %}">
    <div class="chap-body">
      {% if fragments is defined and fragments.toc %}
      <aside class="chap-toc">
        <input type="checkbox" id="chap-toc-toggle" class="chap-toc__toggle" autocomplete="off">
        <label for="chap-toc-toggle" class="chap-toc__open">
          <span class="chap-toc__open-label">Contents</span>
        </label>
        <div class="chap-toc__overlay">
          <label for="chap-toc-toggle" class="chap-toc__backdrop" aria-hidden="true"></label>
          <div class="chap-toc__drawer" role="dialog" aria-label="Contents" aria-modal="true">
            <header class="chap-toc__drawer-head">
              <span class="chap-toc__drawer-title">Contents</span>
              <label for="chap-toc-toggle" class="chap-toc__close">Close</label>
            </header>
            <div class="chap-toc__body">
              {{ fragments.toc | safe }}
            </div>
          </div>
        </div>
      </aside>
      {% endif %}
      <article class="content">
        {{ content_html | safe }}
      </article>
      {% if show_facsimile %}
      <!-- pb-facs-link emits the manifest URL and page index on the
           "transcription" channel; pb-tify subscribes and turns to that page. -->
      <aside class="chap-facs" aria-label="Facsimile">
        <pb-tify subscribe="transcription" emit="transcription"></pb-tify>
      </aside>
      {% endif %}
    </div>
  </main>

  {% if is_chunk and (chunk.prev or chunk.next) %}
  <nav class="chap-folio-nav" aria-label="Chapter navigation">
    <div class="chap-folio-nav__prev">
      {% if chunk.prev %}
      <a href="{{ chunk.prev }}.html">
        <span class="chap-folio-nav__label">Verso</span>
        <span class="chap-folio-nav__chevron" aria-hidden="true">&lsaquo;</span>
        <span class="chap-folio-nav__dir">Previous</span>
      </a>
      {% endif %}
    </div>
    <div class="chap-folio-nav__next">
      {% if chunk.next %}
      <a href="{{ chunk.next }}.html">
        <span class="chap-folio-nav__label">Recto</span>
        <span class="chap-folio-nav__dir">Next</span>
        <span class="chap-folio-nav__chevron" aria-hidden="true">&rsaquo;</span>
      </a>
      {% endif %}
    </div>
  </nav>
  {% endif %}
</body>
</html>
