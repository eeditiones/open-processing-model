{#
  SPDX-FileCopyrightText: 2026 e-editiones
  SPDX-License-Identifier: CC0-1.0

  journal: a single-column scholarly article with a sticky masthead and a
  contents rail, on opm's packaged page layout (opm/layout.html.j2). The
  masthead is the layout's menubar: the journal line in place of the logo,
  the article title on the right. The rail is the layout's `before` column;
  journal.css styles it all.

  Its stylesheet, journal.css, is listed under [transform.web] assets in
  opm.toml: copied next to the output and linked by the base template.
-#}
---toml
styles = [
  "https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..600&display=swap",
]

[body]
classes = ["jr"]
---
{% extends "opm/layout.html.j2" %}
{% set work_title = fragments.title | striptags | trim if fragments is defined and fragments.title else '' %}
{% set is_chunk = chunk is defined and chunk %}
{% set has_toc = fragments is defined and fragments.toc %}
{% set has_journal = fragments is defined and fragments.journal %}

{% block meta %}{{ super() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% endblock %}

{% block title %}<title>{{ work_title or 'Journal article' }}</title>{% endblock %}

{% block body_class %}
  {%- if has_toc %} jr--with-toc{% endif %}
  {%- if is_chunk %} jr--chunk{% endif %}
  {%- if has_journal %} jr--journal-meta{% endif %}
{% endblock %}

{% block logo %}
  {%- if has_journal %}
    {%- if index_url %}<a class="jr-journal" href="{{ index_url }}">{{ fragments.journal | safe }}</a>
    {%- else %}<div class="jr-journal">{{ fragments.journal | safe }}</div>{% endif %}
  {%- endif %}
{% endblock %}

{% block menu_toggles %}
  {% if is_chunk and work_title %}<li class="jr-article">{{ work_title }}</li>{% endif %}
{% endblock %}

{% block before %}
  {% if has_toc %}
  <nav class="jr-rail__nav" aria-label="Article contents">
    <p class="jr-rail__title">Contents</p>
    {{ fragments.toc | safe }}
  </nav>
  {% endif %}
{% endblock %}

{% block content %}
  <article class="content">
    {{ content_html | safe }}
  </article>

  {% if is_chunk and (chunk.prev or chunk.next) %}
  <nav class="jr-pager" aria-label="Article navigation">
    <div class="jr-pager__slot">
      {% if chunk.prev %}
      <a href="{{ chunk.prev }}.html" rel="prev">
        <span class="jr-pager__dir">&larr; Previous</span>
      </a>
      {% endif %}
    </div>
    <div class="jr-pager__slot jr-pager__slot--next">
      {% if chunk.next %}
      <a href="{{ chunk.next }}.html" rel="next">
        <span class="jr-pager__dir">Next &rarr;</span>
      </a>
      {% endif %}
    </div>
  </nav>
  {% endif %}
{% endblock %}
