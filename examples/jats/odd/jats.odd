<?xml-model href="teipublisher_odds.xsd"?>
<TEI xmlns:pb="http://teipublisher.com/1.0" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.tei-c.org/ns/1.0" xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>JATS













                 <desc>Processing of JATS XML (Journal Article Tag Suite)</desc>
                </title>
            </titleStmt>
            <publicationStmt>
                <publisher>e-editiones</publisher>
                <availability>
                    <licence target="https://creativecommons.org/licenses/by/4.0/">Distributed under a
                        Creative Commons Attribution 4.0 International License</licence>
                    <p>Copyright 2017–2026 <ref target="https://e-editiones.org">e-editiones</ref> and
                        individual contributors.</p>
                    <p>Based on TEI materials © TEI Consortium (CC BY 3.0 / BSD-2-Clause).</p>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Generated by <ref target="http://tei-publisher.com">TEI Publisher</ref>
                </p>
            </sourceDesc>
        </fileDesc>
        <encodingDesc>
            <tagsDecl>
                <rendition source="jats.css"/>
            </tagsDecl>
        </encodingDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" ident="jats" ns="">
                <elementSpec ident="body" mode="add">
                    <model behaviour="body"/>
                </elementSpec>
                <elementSpec ident="sec" mode="add">
                    <model predicate="$parameters?mode='title'" behaviour="inline">
                        <param name="content" value="root($parameters?root)//front/article-meta/title-group"/>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc' and sec and not($parameters?collapse)"
                        behaviour="pass-through">
                        <desc>Static/OPM TOC: nested, expanded (live TOC uses nav:toc-entry).
                            JATS identifies sections with @id, not @xml:id.</desc>
                        <param name="id" value="@id"/>
                        <param name="heading" value="title"/>
                        <param name="children" value="sec"/>
                        <param name="target" value="($parameters?target, 'transcription')[1]"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <details open="open">
    <summary>
      <pb-link xml-id="[[id]]" node-id="[[id]]" emit="[[target]]" subscribe="[[target]]">[[heading]]</pb-link>
    </summary>
    <ul>[[children]]</ul>
  </details>
</li></pb:template>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc' and sec and $parameters?collapse"
                        behaviour="pass-through">
                        <desc>Static/OPM TOC: nested, collapsed</desc>
                        <param name="id" value="@id"/>
                        <param name="heading" value="title"/>
                        <param name="children" value="sec"/>
                        <param name="target" value="($parameters?target, 'transcription')[1]"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <details>
    <summary>
      <pb-link xml-id="[[id]]" node-id="[[id]]" emit="[[target]]" subscribe="[[target]]">[[heading]]</pb-link>
    </summary>
    <ul>[[children]]</ul>
  </details>
</li></pb:template>
                    </model>
                    <model output="opm-web" predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <desc>Static/OPM TOC: leaf entry</desc>
                        <param name="id" value="@id"/>
                        <param name="heading" value="title"/>
                        <param name="target" value="($parameters?target, 'transcription')[1]"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <pb-link xml-id="[[id]]" node-id="[[id]]" emit="[[target]]" subscribe="[[target]]">[[heading]]</pb-link>
</li></pb:template>
                    </model>
                    <model behaviour="section"/>
                </elementSpec>
                <elementSpec ident="front" mode="add">
                    <desc>front is a chunk of its own (see opm.navigation.jats_sec_chunks), so it
                        needs a TOC entry. It carries no @id, so anchor on the first id inside it.</desc>
                    <model output="opm-web" predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <param name="id" value="(descendant::*[@id])[1]/@id"/>
                        <param name="heading" value="article-meta/title-group/article-title"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <pb-link xml-id="[[id]]" node-id="[[id]]" emit="transcription" subscribe="transcription">[[heading]]</pb-link>
</li></pb:template>
                    </model>
                    <model output="opm-print" behaviour="block" cssClass="frontmatter">
                        <desc>Paged media only: wraps the title, byline and abstract in a block the
                            print stylesheet can put on its own @page Title. The web view leaves
                            front as pass-through, so this model is scoped to print.</desc>
                    </model>
                </elementSpec>
                <elementSpec ident="title" mode="add">
                    <model predicate="$parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="parent::caption or parent::abstract" behaviour="heading">
            <param name="level" value="2"/>
            <outputRendition xml:space="preserve">
            margin-bottom: 0;
            </outputRendition>
        </model>
                    <model behaviour="heading">
            <param name="level" value="count(ancestor::sec) + 1"/>
        </model>
                </elementSpec>
                <elementSpec ident="p" mode="add">
                    <model predicate="ancestor::fn" behaviour="inline"/>
                    <model predicate="ancestor::td" behaviour="block"/>
                    <model behaviour="paragraph"/>
                </elementSpec>
                <elementSpec ident="list" mode="add">
                    <model behaviour="list">
            <param name="type" value="if (@list-type = 'order') then 'ordered' else ()"/>
        </model>
                </elementSpec>
                <elementSpec ident="list-item" mode="add">
                    <model behaviour="listItem"/>
                </elementSpec>
                <elementSpec ident="uri" mode="add">
                    <model behaviour="link">
            <param name="uri" value="@xlink:href"/>
        </model>
                </elementSpec>
                <elementSpec ident="bold" mode="add">
                    <model behaviour="inline">
            <outputRendition xml:space="preserve">
            font-weight: bold;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="italic" mode="add">
                    <model behaviour="inline">
            <outputRendition xml:space="preserve">
            font-style: italic;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="underline" mode="add">
                    <model behaviour="inline">
            <outputRendition xml:space="preserve">
            text-decoration: underline;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="strike" mode="add">
                    <model behaviour="inline">
            <outputRendition xml:space="preserve">
            text-decoration: line-through;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="table-wrap" mode="add">
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="table" mode="add">
                    <model behaviour="table" cssClass="table">
            <outputRendition xml:space="preserve">

            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="tr">
                    <model behaviour="row"/>
                </elementSpec>
                <elementSpec ident="td">
                    <model behaviour="cell">
            <outputRendition xml:space="preserve">
            padding 0 4px;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="th">
                    <model behaviour="cell" useSourceRendition="true">
            <outputRendition xml:space="preserve">













            font-weight: bold;
text-align: left;
padding: 0 4px;













            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="article-meta" mode="add">
                    <model output="typst" behaviour="pass-through">
                        <desc>Front matter feeds the Typst title block; nothing is printed here.
                            Every element listed has an output="typst" metadata model of its own,
                            so adding one here without one there would print it into the flow.</desc>
                        <param name="content" value="(title-group/article-title, contrib-group/contrib, abstract,
                            (pub-date[@iso-8601-date], pub-date)[1], volume, elocation-id,
                            article-id[@pub-id-type='doi'], permissions/license)"/>
                    </model>
                    <model predicate="$parameters?display='browse'" behaviour="block">
                        <param name="content" value="(title-group, contrib-group)"/>
                    </model>
                    <modelSequence>
                        <desc>Front matter of a journal article: title, byline, affiliations,
                            the citation line, abstract and rights. The packaged jats.odd stops
                            after title/byline/abstract — everything else is added here.</desc>
                        <model behaviour="pass-through">
                            <param name="content" value="title-group"/>
                        </model>
                        <model behaviour="block" cssClass="flex">
                            <param name="content" value="(contrib-group, (pub-date[@iso-8601-date], pub-date)[1])"/>
                            <outputRendition xml:space="preserve">
                            margin-bottom: .5em;
                            </outputRendition>
                        </model>
                        <model behaviour="block" cssClass="affiliations">
                            <param name="content" value="aff"/>
                        </model>
                        <model behaviour="block" cssClass="citation-line">
                            <desc>Volume, article number and DOI, the way a journal cites itself.</desc>
                            <param name="content" value="(volume, elocation-id, article-id[@pub-id-type='doi'])"/>
                        </model>
                        <model behaviour="block">
                            <param name="content" value="abstract"/>
                        </model>
                        <model behaviour="block">
                            <param name="content" value="permissions"/>
                        </model>
                    </modelSequence>
                </elementSpec>
                <elementSpec ident="title-group" mode="add">
                    <model predicate="$parameters?mode=('breadcrumb', 'title')" behaviour="inline">
                        <param name="content" value="article-title/text()"/>
                    </model>
                    <modelSequence predicate="$parameters?display='browse'">
                        <model behaviour="link">
                            <param name="content" value="article-title"/>
                            <param name="uri" value="$parameters?doc"/>
                        </model>
                        <model behaviour="block">
                            <param name="content" value="subtitle"/>
                        </model>
                    </modelSequence>
                </elementSpec>
                <elementSpec ident="article-title" mode="add">
                    <model output="typst" predicate="ancestor::article-meta" behaviour="metadata">
                        <desc>Feeds the Typst title block instead of printing in the flow.</desc>
                        <param name="key" value="'title'"/>
                    </model>
                    <model predicate="$parameters?mode=('breadcrumb', 'toc')" behaviour="inline"/>
                    <model predicate="$parameters?display='browse'" behaviour="heading">
            <param name="level" value="5"/>
        </model>
                    <modelSequence output="docx" predicate="ancestor::article-meta">
                        <desc>Fills the .docx core document properties (Title/Author/Comments)
                            while still printing the front matter. behaviour="metadata" emits
                            nothing, so it is paired with the display model in a sequence rather
                            than replacing it — a journal article that opened on its first section,
                            with the title only in File → Properties, would read wrongly.
                            Inert wherever pmf:metadata is a no-op: the display model still runs,
                            so this output is unchanged from a plain block.</desc>
                        <model behaviour="metadata">
                            <param name="key" value="'title'"/>
                        </model>
                        <model behaviour="heading" cssClass="title">
                            <param name="level" value="1"/>
                        </model>
                    </modelSequence>
                    <model predicate="ancestor::article-meta" behaviour="heading" cssClass="title">
            <param name="level" value="1"/>
        </model>
                    <model predicate="ancestor::ref-list" behaviour="pass-through"/>
                </elementSpec>
                <elementSpec ident="subtitle" mode="add">
                    <model behaviour="heading">
            <param name="level" value="5"/>
        </model>
                </elementSpec>
            <elementSpec ident="caption" mode="add">
                <model behaviour="block" cssClass="figure-head"/>
            </elementSpec>
                <elementSpec ident="disp-quote" mode="add">
                    <model behaviour="cit"/>
                </elementSpec>
                <elementSpec ident="fn" mode="add">
                    <model predicate="label" behaviour="note">
            <param name="n" value="label/string()"/>
            <param name="content" value="node() except label"/>
        </model>
                    <model behaviour="note"/>
                </elementSpec>
                <elementSpec ident="label" mode="add">
                    <model behaviour="block">
            <outputRendition xml:space="preserve">
            font-weight: bold;
            </outputRendition>
        </model>
                </elementSpec>
                <elementSpec ident="xref" mode="add">
                    <model predicate="@ref-type='bibr'" behaviour="link">
            <param name="uri" value="'#' || @rid"/>
        </model>
                    <model predicate="@ref-type='fn'" behaviour="pass-through">
            <param name="content" value="let $rid := @rid return root($parameters?root)//fn[@id=$rid]"/>
        </model>
                </elementSpec>
                <elementSpec ident="contrib" mode="add">
                    <modelSequence output="typst">
                        <desc>Two metadata entries from one element: _dispatch stops at the
                            first matching model, so an unpredicated pair would emit only
                            the first. A modelSequence applies every child in turn.</desc>
                        <model output="typst" behaviour="metadata">
                            <param name="key" value="'authors'"/>
                            <param name="content" value="name"/>
                        </model>
                        <model output="typst" behaviour="metadata">
                            <desc>Everything a journal title block needs about one contributor,
                                beyond the plain name above. A metadata key holds a flat list of
                                strings, so the four fields travel as one pipe-joined record for the
                                template to split apart (see examples/jats/templates/article.typ.j2);
                                shells that only want names read 'authors' and ignore this. The
                                affiliation is not a child of contrib: it is reached through
                                xref/@rid, the way JATS links the two.</desc>
                            <param name="key" value="'author_records'"/>
                            <param name="content" value="let $c := . return
                                let $aff := $c/ancestor::article-meta/aff[@id = $c/xref[@ref-type='aff']/@rid] return
                                string-join((
                                    normalize-space(string-join(($c/name/given-names, $c/name/surname), ' ')),
                                    normalize-space($c/email),
                                    string-join(for $e in $aff/*[normalize-space()] return normalize-space($e), ', '),
                                    replace(normalize-space($c/contrib-id[@contrib-id-type='orcid']), '^https?://orcid\.org/', '')
                                ), '|')"/>
                        </model>
                    </modelSequence>
                    <model predicate="preceding-sibling::contrib" behaviour="inline">
            <param name="content" value="(name, contrib-id, email)"/>
            <outputRendition xml:space="preserve" scope="after">
            content: ', ';
            </outputRendition>
        </model>
                    <model behaviour="inline">
            <param name="content" value="(name, contrib-id, email)"/>
        </model>
                </elementSpec>
                <elementSpec ident="contrib-id" mode="add">
                    <desc>An ORCID is stored as a full https://orcid.org/… URI, so it links to itself.</desc>
                    <model predicate="@contrib-id-type='orcid'" behaviour="link" cssClass="orcid">
                        <param name="uri" value="normalize-space(.)"/>
                        <param name="content" value="'ORCID'"/>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="email" mode="add">
                    <model behaviour="link" cssClass="email">
                        <param name="uri" value="'mailto:' || normalize-space(.)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="aff" mode="add">
                    <desc>Affiliation: department, institution and place on one line. Empty
                        addr-line/city elements are common in JATS, so filter the blanks out.</desc>
                    <model behaviour="block" cssClass="aff">
                        <param name="content" value="*[normalize-space()]"/>
                    </model>
                </elementSpec>
                <elementSpec ident="institution" mode="add">
                    <model predicate="preceding-sibling::institution" behaviour="inline">
                        <outputRendition xml:space="preserve" scope="before">
                        content: ', ';
                        </outputRendition>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="city" mode="add">
                    <model behaviour="inline">
                        <outputRendition xml:space="preserve" scope="before">
                        content: ', ';
                        </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="country" mode="add">
                    <model behaviour="inline">
                        <outputRendition xml:space="preserve" scope="before">
                        content: ', ';
                        </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="volume" mode="add">
                    <model output="typst" behaviour="metadata">
                        <param name="key" value="'volume'"/>
                    </model>
                    <model behaviour="inline">
                        <outputRendition xml:space="preserve" scope="before">
                        content: 'Vol. ';
                        </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="elocation-id" mode="add">
                    <model output="typst" behaviour="metadata">
                        <param name="key" value="'elocation'"/>
                    </model>
                    <model behaviour="inline">
                        <outputRendition xml:space="preserve" scope="before">
                        content: ', article ';
                        </outputRendition>
                        <outputRendition xml:space="preserve" scope="after">
                        content: ' · ';
                        </outputRendition>
                    </model>
                </elementSpec>
                <elementSpec ident="article-id" mode="add">
                    <desc>Only the DOI is shown; publisher ids stay out of the reading view.</desc>
                    <model output="typst" predicate="@pub-id-type='doi'" behaviour="metadata">
                        <param name="key" value="'doi'"/>
                        <param name="content" value="replace(normalize-space(.), '^https?://(dx\.)?doi\.org/', '')"/>
                    </model>
                    <model predicate="@pub-id-type='doi'" behaviour="link" cssClass="doi">
                        <param name="uri" value="if (starts-with(normalize-space(.), 'http')) then normalize-space(.) else 'https://doi.org/' || normalize-space(.)"/>
                        <param name="content" value="'doi:' || replace(normalize-space(.), '^https?://(dx\.)?doi\.org/', '')"/>
                    </model>
                    <model behaviour="omit"/>
                </elementSpec>
                <elementSpec ident="permissions" mode="add">
                    <model behaviour="block" cssClass="permissions">
                        <param name="content" value="(copyright-statement, license)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="license" mode="add">
                    <desc>The licence URI lives on @xlink:href; license-p repeats it as text,
                        so print the href as a link and drop the duplicate paragraph.</desc>
                    <model output="typst" behaviour="metadata">
                        <param name="key" value="'license'"/>
                        <param name="content" value="string(@xlink:href)"/>
                    </model>
                    <model predicate="@xlink:href" behaviour="link" cssClass="license">
                        <param name="uri" value="string(@xlink:href)"/>
                        <param name="content" value="string(@xlink:href)"/>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="contrib-group" mode="add">
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="inline">
            <param name="content" value="contrib"/>
            <outputRendition xml:space="preserve" scope="before">
            content: ' - ';
            </outputRendition>
        </model>
                    <modelSequence output="docx">
                        <desc>Collected on the group, not on contrib, so several authors join
                            with a comma instead of running together in one string.</desc>
                        <model behaviour="metadata">
                            <param name="key" value="'authors'"/>
                            <param name="content" value="string-join(for $c in contrib return
                                normalize-space(string-join(($c/name/given-names, $c/name/surname), ' ')), ', ')"/>
                        </model>
                        <model behaviour="block">
                            <param name="content" value="contrib"/>
                        </model>
                    </modelSequence>
                    <model behaviour="block">
            <param name="content" value="contrib"/>
        </model>
                </elementSpec>
            <elementSpec ident="code" mode="add">
                    <model behaviour="webcomponent">
            <param name="name" value="'pb-code-highlight'"/>
            <param name="language" value="(@language, 'xml')[1]"/>
            <param name="line-numbers" value="false()"/>
        </model>
                </elementSpec>
                <elementSpec ident="preformat" mode="add">
                    <model behaviour="pass-through">
            <pb:template xmlns="" xml:space="preserve"><pre>[[content]]</pre></pb:template>
        </model>
                </elementSpec>
                <elementSpec ident="monospace" mode="add">
                    <model behaviour="inline" cssClass="code"/>
                </elementSpec>
                <elementSpec ident="ext-link" mode="add">
                    <model behaviour="link">
            <param name="uri" value="@xlink:href"/>
        </model>
                </elementSpec>
                <elementSpec ident="figure" mode="add"/>
                <elementSpec ident="fig" mode="add">
                    <model predicate="@position='float'" behaviour="figure" cssClass="float-right">
            <param name="content" value="(graphic, caption)"/>
        </model>
                    <model behaviour="figure">
            <param name="content" value="(graphic, caption)"/>
        </model>
                </elementSpec>
                <elementSpec ident="graphic" mode="add">
                    <model behaviour="graphic">
            <param name="url" value="@xlink:href"/>
        </model>
                </elementSpec>
                <elementSpec ident="abstract" mode="add">
                    <model output="typst" behaviour="metadata">
                        <param name="key" value="'abstract'"/>
                        <param name="content" value="node() except title"/>
                    </model>
                    <modelSequence output="docx">
                        <model behaviour="metadata">
                            <param name="key" value="'abstract'"/>
                            <param name="content" value="node() except title"/>
                        </model>
                        <model behaviour="block" cssClass="abstract"/>
                    </modelSequence>
                    <model behaviour="block" cssClass="abstract"/>
                </elementSpec>
            <elementSpec ident="name" mode="add">
                    <model behaviour="inline">
            <param name="content" value="(given-names,surname)"/>
        </model>
                </elementSpec>
                <elementSpec ident="surname" mode="add">
                    <model predicate="../given-names" behaviour="inline">
            <param name="content" value="(' ', .)"/>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="pub-date" mode="add">
                    <desc>Upstream calls XSLT's format-date(), which the XPath 3.1 engine does not
                        provide — every date came out empty. opm ships the equivalent as an
                        extension function: tp:format_date(iso-value, locale) from
                        opm.runtime.common_xpath_functions, which opm init lists under
                        [transform] xpath_extensions. Without that module loaded the date is empty
                        again, exactly as before, rather than an error.</desc>
                    <model output="typst" behaviour="metadata">
                        <param name="key" value="'date'"/>
                        <param name="content" value="tp:format_date(@iso-8601-date, ($parameters?language, 'en')[1])"/>
                    </model>
                    <model behaviour="block" cssClass="pub-date">
                        <param name="content" value="tp:format_date(@iso-8601-date, ($parameters?language, 'en')[1])"/>
                    </model>
                </elementSpec>
                <elementSpec ident="disp-formula" mode="add">
                    <model behaviour="pass-through">
            <pb:template xmlns="" xml:space="preserve">
                            <pb-formula menu="menu" display="display">
                                [[content]]
                            </pb-formula>
                        </pb:template>
        </model>
                </elementSpec>
                <elementSpec ident="mml:math">
                    <model behaviour="pass-through">
            <pb:template xmlns="" xml:space="preserve">
                            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">[[content]]</math>
                        </pb:template>
        </model>
                </elementSpec>
            <elementSpec ident="article" mode="add">
                    <model output="opm-web" predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <desc>Widens the packaged model, which lists body/sec only because that is
                            what eXist-side JATS navigation chunks. opm.navigation.jats_sec_chunks
                            also makes front and back chunks of their own, so they need entries or
                            two of the three pages here would be unreachable from the TOC.</desc>
                        <param name="content" value="front | body/sec | back[node()]"/>
                        <pb:template xml:space="preserve"><ul xmlns="" class="toc">[[content]]</ul></pb:template>
                    </model>
                    <model predicate="$parameters?mode='metadata'" behaviour="block">
            <param name="content" value="(front/journal-meta, front/article-meta)"/>
        </model>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="pass-through">
            <param name="content" value="front/article-meta/title-group"/>
        </model>
                    <model behaviour="document"/>
                </elementSpec>
            <elementSpec ident="back" mode="add">
                    <model output="opm-web" predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <desc>TOC entry for the back matter chunk; like front it has no @id.</desc>
                        <param name="id" value="(descendant::*[@id])[1]/@id"/>
                        <param name="heading" value="ref-list/title"/>
                        <pb:template xml:space="preserve"><li xmlns="">
  <pb-link xml-id="[[id]]" node-id="[[id]]" emit="transcription" subscribe="transcription">[[heading]]</pb-link>
</li></pb:template>
                    </model>
                    <model behaviour="block">
            <param name="content" value="ref-list"/>
        </model>
                </elementSpec>
            <elementSpec ident="ref-list" mode="add">
                    <modelSequence>
            <model behaviour="pass-through">
                <param name="content" value="title"/>
            </model>
            <model behaviour="list" cssClass="references">
                <param name="type" value="'ordered'"/>
                <param name="content" value="ref"/>
            </model>
        </modelSequence>
                </elementSpec>
                <elementSpec ident="ref" mode="add">
                    <model output="web" behaviour="pass-through">
                        <param name="title" value=".//article-title"/>
                        <param name="source" value="if (exists(.//source)) then (&#34; In: &#34;,.//source, (&#34;, &#34;)) else ()"/>
                        <param name="authors" value="let $names := for $name in  .//person-group[@person-group-type='author']/name return normalize-space($name) return string-join($names, ', ')"/>
                        <param name="year" value=".//year"/>
                        <param name="id" value="@id"/>
                        <pb:template xmlns="" xml:space="preserve"><li id="[[id]]">[[authors]]: [[title]]. [[source]][[year]]</li></pb:template>
                    </model>
                    <model behaviour="listItem">
            <param name="title" value=".//article-title"/>
            <param name="source" value="if (exists(.//source)) then (&#34; In: &#34;,.//source, (&#34;, &#34;)) else ()"/>
            <param name="authors" value="let $names := for $name in  .//person-group[@person-group-type='author']/name return normalize-space($name) return string-join($names, ', ')"/>
            <param name="year" value=".//year"/>
            <pb:template xmlns="" xml:space="preserve">[[authors]]: [[title]]. [[source]][[year]]</pb:template>
        </model>
                </elementSpec>
            <elementSpec ident="journal-meta" mode="add">
                    <model output="typst" behaviour="metadata">
                        <desc>Feeds the citation line under the Typst title; nothing prints here.</desc>
                        <param name="key" value="'journal'"/>
                        <param name="content" value="normalize-space(.//journal-title)"/>
                    </model>
                    <model behaviour="block" cssClass="journal-meta">
                        <param name="content" value="(.//journal-title, publisher, issn)"/>
                    </model>
                </elementSpec>
                <elementSpec ident="journal-title" mode="add">
                    <model behaviour="inline" cssClass="journal-title"/>
                </elementSpec>
                <elementSpec ident="journal-title-group" mode="add">
                    <model behaviour="inline" cssClass="journal-title-group"/>
                </elementSpec>
                <elementSpec ident="publisher" mode="add">
                    <model behaviour="inline" output="docx">
                        <param name="content" value="(', ', .)"/>
                    </model>
                    <model behaviour="inline" cssClass="publisher"/>
                </elementSpec>
            <elementSpec ident="issn" mode="add">
                <model output="docx" behaviour="inline">
                    <param name="content" value="(', ', .)"/>
                </model>
                    <model behaviour="inline" cssClass="issn"/>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>
