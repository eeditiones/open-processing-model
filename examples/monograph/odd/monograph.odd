<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:pb="http://teipublisher.com/1.0">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Monograph</title>
            </titleStmt>
            <publicationStmt>
                <publisher>e-editiones</publisher>
                <availability status="free">
                    <p>Inherits from <code>teipublisher.odd</code> (<att>source</att> on
                        <gi>schemaSpec</gi>), distributed under a Creative Commons Attribution 4.0
                        International License, copyright 2017–2026 e-editiones and individual
                        contributors.</p>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Processing model for a critical edition of a monograph, shown on a chapter
                    of the Karl Barth-Gesamtausgabe (Der Römerbrief 1922).</p>
            </sourceDesc>
        </fileDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec ident="monograph" start="TEI teiCorpus" source="teipublisher.odd">
                <elementSpec ident="anchor" mode="change">
                    <model predicate="$parameters?mode=('toc', 'title', 'breadcrumb')" behaviour="omit"/>
                    <model output="typst" predicate="@type = 'note'" behaviour="inline" cssClass="note-range-start">
                        <desc>Typst: the opening marker (a-) as a styled superscript, like the
                            web's lettered callouts; the note itself supplies -a.</desc>
                        <param name="content" value="let $id := @xml:id return (root($parameters?root)//note[@target = $id or @target = '#' || $id])[1]/@n/string() || '-'"/>
                    </model>
                    <model predicate="@type = 'note'" behaviour="note">
                        <desc>Start of a lemma range: the text-critical note sits at the end of
                            the passage with @target pointing here. Emit the opening marker
                            (a-) only; the note at the end supplies -a and the a-a footnote
                            label. This edition keeps notes inline, not in listAnnotation.</desc>
                        <param name="place" value="'start'"/>
                        <param name="label" value="let $id := @xml:id return (root($parameters?root)//note[@target = $id or @target = '#' || $id])[1]/@n/string()"/>
                        <param name="content" value="()"/>
                    </model>
                </elementSpec>
                <elementSpec ident="body" mode="change">
                    <model predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <desc>Contents: one list of chapters, for the `toc` fragment in
                            opm.toml.</desc>
                        <param name="content" value="div"/>
                        <pb:template xml:space="preserve" xmlns=""><ol>[[content]]</ol></pb:template>
                    </model>
                </elementSpec>
                <elementSpec ident="div" mode="change">
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="pass-through">
                        <desc>Breadcrumb of a chunk: the work title and chapter of the enclosing
                            divs, then this div's own title(s). The chapter div also carries the
                            heads of its first section (small caps, pericope), which are not
                            part of the path.</desc>
                        <param name="content" value="(ancestor::div/head[not(@type = 'sub')][not(hi/@rend = 'smallCaps')], head[not(@type = 'sub')])"/>
                        <pb:template xml:space="preserve" xmlns=""><ol>[[content]]</ol></pb:template>
                    </model>
                    <model predicate="$parameters?mode='toc' and parent::body" behaviour="pass-through">
                        <desc>Contents entry of a chapter: the line before the lb of its head
                            ("1. Kapitel"), then the title after it and the titles of its parts
                            (DIE NACHT), set in title case. Below it the sections: the chapter's
                            own opening section, then its child divs.</desc>
                        <param name="id" value="@xml:id"/>
                        <param name="num" value="normalize-space(string-join(head[lb][1]/lb/preceding-sibling::text(), ''))"/>
                        <param name="title" value="let $titles := (normalize-space(string-join(head[lb][1]/lb/following-sibling::text(), '')), div/head[not(@type)][not(*)] ! normalize-space(.)) return string-join(for $t in $titles return string-join(for $w in tokenize(lower-case($t), ' ') return upper-case(substring($w, 1, 1)) || substring($w, 2), ' '), ' · ')"/>
                        <param name="sections" value="(head[hi/@rend = 'smallCaps'], div)"/>
                        <pb:template xml:space="preserve" xmlns=""><li class="rb-toc__chapter"><a href="#[[id]]"><span class="rb-toc__num">[[num]]</span>[[title]]</a><ol class="rb-toc__sections">[[sections]]</ol></li></pb:template>
                    </model>
                    <model predicate="$parameters?mode='toc'" behaviour="pass-through">
                        <desc>A section adds no entry of its own: its small-caps head is the
                            entry.</desc>
                        <param name="content" value="head[hi/@rend = 'smallCaps']"/>
                    </model>
                    <model predicate="$parameters?mode = 'register'" behaviour="pass-through">
                        <desc>Output register data if register profile is enabled</desc>
                        <param name="people" value="let $refs := (root(.)//persName[@key or @ref][not(ancestor::correspContext)], root(.)//rs[@type='person'][@key or @ref][not(ancestor::correspContext)]), $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  return for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::person]"/>
                        <param name="places" value="let $refs := (root(.)//placeName[@key or @ref][not(ancestor::correspContext)], root(.)//rs[@type='place'][@key or @ref][not(ancestor::correspContext)]), $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  return for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::place]"/>
                        <pb:template xml:space="preserve" xmlns=""><div class="register">
<h3><pb-i18n key="register-details.people">ppl</pb-i18n></h3>
<ul>
[[people]]
</ul>

<h3><pb-i18n key="register-details.places">pl</pb-i18n></h3>
<ul>
[[places]]
</ul>
</div></pb:template>
                    </model>
                    <model predicate="$parameters?mode='title'" behaviour="inline">
                        <param name="content" value="root($parameters?root)//teiHeader/fileDesc/titleStmt"/>
                    </model>
                    <model predicate="parent::body or parent::front or parent::back" behaviour="section"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="head" mode="change">
                    <model predicate="$parameters?mode='toc' and hi/@rend = 'smallCaps'" behaviour="pass-through">
                        <desc>Contents entry of a section: its title, then the pericope from the
                            following sub head. Links to the div, which is the section's page.</desc>
                        <param name="id" value="parent::div/@xml:id"/>
                        <param name="title" value="normalize-space(string-join(hi[@rend = 'smallCaps']//text(), ''))"/>
                        <param name="ref" value="normalize-space(following-sibling::head[@type = 'sub'][1])"/>
                        <pb:template xml:space="preserve" xmlns=""><li><a href="#[[id]]">[[title]] <span class="rb-toc__ref">[[ref]]</span></a></li></pb:template>
                    </model>
                    <model predicate="$parameters?mode='toc' and $parameters?mode-sub='toc-odd'" behaviour="pass-through">
                        <param name="id" value="parent::div/@xml:id"/>
                        <param name="hash" value="parent::div/@xml:id"/>
                        <param name="node-id" value="util:node-id(.)"/>
                        <pb:template xml:space="preserve">
                            <pb-link xmlns="" xml-id="[[id]]" hash="[[hash]]" node-id="[[node-id]]" emit="transcription" subscribe="transcription">[[content]]</pb-link>
                        </pb:template>
                    </model>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="listItem">
                        <desc>One crumb: the head's text, an lb read as a space, notes and
                            page breaks left out.</desc>
                        <param name="content" value="normalize-space(string-join(for $n in .//(text() | lb)[not(ancestor::note)] return if ($n/self::lb) then ' ' else string($n), ''))"/>
                    </model>
                    <model predicate="$parameters?display='browse' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="parent::figure" behaviour="block" cssClass="figure-head"/>
                    <model predicate="parent::table" behaviour="block" cssClass="table-head"/>
                    <model predicate="parent::lg" behaviour="block" cssClass="lg-head"/>
                    <model predicate="parent::list" behaviour="block" cssClass="list-head"/>
                    <model output="epub" predicate="parent::div and @type='top'" behaviour="heading" cssClass="rb-title">
                        <desc>EPUB: the kind of head as a class, since not every reading
                            system supports the :has() rules monograph.css uses.</desc>
                        <param name="level" value="count(ancestor::div)"/>
                    </model>
                    <model output="epub" predicate="parent::div and lb" behaviour="heading" cssClass="rb-chapter">
                        <param name="level" value="count(ancestor::div)"/>
                    </model>
                    <model output="epub" predicate="parent::div and not(@type)" behaviour="heading" cssClass="rb-section">
                        <param name="level" value="count(ancestor::div)"/>
                    </model>
                    <model predicate="parent::div and @type='sub'" behaviour="heading" cssClass="monograph-subhead">
                        <desc>Subheading (the Bible passage below a section title): same level,
                            smaller and set close to the heading above. Sized in monograph.css,
                            where it can outrank the template's heading styles.</desc>
                        <param name="level" value="count(ancestor::div)"/>
                    </model>
                    <model predicate="parent::div" behaviour="heading">
                        <param name="level" value="count(ancestor::div)"/>
                    </model>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="hi" mode="change">
                    <model predicate="@rend = 'bold'" behaviour="inline">
                        <outputRendition xml:space="preserve">
                        font-weight: bold;
                        </outputRendition>
                    </model>
                    <model behaviour="inline" useSourceRendition="true"/>
                </elementSpec>
                <elementSpec ident="pb" mode="change">
                    <model predicate="$parameters?mode='toc'" behaviour="omit"/>
                    <model predicate="$parameters?mode=('title', 'breadcrumb')" behaviour="omit"/>
                    <model predicate="@ed != 'pga'" behaviour="omit">
                        <desc>Only the page breaks of the Gesamtausgabe itself are shown.</desc>
                    </model>
                    <model output="print" behaviour="omit"/>
                    <model output="typst" predicate="@rend = 'noPipe' or (parent::div and not(preceding-sibling::*))" behaviour="inline" cssClass="monograph-pb-nopipe">
                        <desc>As on the web: no | where the source asks for none or where the
                            break opens a division; the page number alone goes in the margin.</desc>
                        <param name="content" value="replace(@xml:id, '^p0*', '')"/>
                    </model>
                    <model output="typst" behaviour="inline" cssClass="monograph-pb">
                        <desc>The | in the text, the page number in the margin (book.typ.j2).</desc>
                        <param name="content" value="replace(@xml:id, '^p0*', '')"/>
                    </model>
                    <model output="epub" predicate="@rend = 'noPipe' or (parent::div and not(preceding-sibling::*))" behaviour="break" cssClass="monograph-pb monograph-pb-nopipe">
                        <desc>EPUB: a page-break marker reading systems can navigate by;
                            epub.css shows it as on the web, without the |.</desc>
                        <param name="type" value="'page'"/>
                        <param name="label" value="replace(@xml:id, '^p0*', '')"/>
                    </model>
                    <model output="epub" behaviour="break" cssClass="monograph-pb">
                        <param name="type" value="'page'"/>
                        <param name="label" value="replace(@xml:id, '^p0*', '')"/>
                    </model>
                    <model output="web" behaviour="inline" cssClass="monograph-pb">
                        <desc>A | at the exact position of the break (inside the word when
                            @break='no'; suppressed for @rend='noPipe'), the page number in the
                            right margin at the height of the line.</desc>
                        <param name="pipe" value="if (@rend = 'noPipe') then '' else '|'"/>
                        <param name="page" value="replace(@xml:id, '^p0*', '')"/>
                        <pb:template xml:space="preserve" xmlns=""><span class="monograph-pb__pipe">[[pipe]]</span><span class="monograph-pb__page"><span class="monograph-pb__label">[S. [[page]]]</span></span></pb:template>
                        <outputRendition xml:space="preserve">
                        color: grey;
                        </outputRendition>
                    </model>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>
